#!/usr/bin/env python3
"""The `ghostship/freeze` commit status a pull request head carries.

`agent freeze set` records a merge freeze in the repository's Actions variable
`GHOSTSHIP_FREEZE`, and main requires the `ghostship/freeze` status, so a
frozen repository refuses every merge, including one outside `agent pr land`.
This script decides the status for one head from that variable:

* no variable, or a freeze whose `until` has passed: success, "not frozen";
* a freeze whose `until` is still ahead: failure, "frozen until <until>: <reason>";
* a variable that cannot be read as a freeze: failure. A freeze that cannot be
  read is a freeze, so a broken record never opens the repository.

It prints `state=<state>` and `description=<text>`, the two lines the workflow
appends to its step output. `GHOSTSHIP_FREEZE` holds the variable and
`GHOSTSHIP_FREEZE_NOW` (ISO-8601 UTC) overrides the clock for the tests.
"""
from __future__ import annotations

from datetime import datetime, timezone
import json
import os
import sys

DESCRIPTION_LIMIT = 140


def parse_time(text: str) -> datetime:
    value = datetime.fromisoformat(str(text).strip().replace("Z", "+00:00"))
    if value.tzinfo is None:
        raise ValueError("the time carries no zone")
    return value.astimezone(timezone.utc)


def decide(raw: str, now: datetime) -> tuple[str, str]:
    """The status state and description for a head."""
    if not raw.strip():
        return "success", "not frozen"
    try:
        record = json.loads(raw)
        until = parse_time(record["until"])
        reason = str(record.get("reason") or "no reason given")
    except (ValueError, KeyError, TypeError):
        return "failure", "frozen: unreadable freeze record"
    if now >= until:
        return "success", "not frozen"
    stamp = until.strftime("%Y-%m-%dT%H:%M:%SZ")
    return "failure", f"frozen until {stamp}: {reason}"[:DESCRIPTION_LIMIT]


def main() -> int:
    override = os.environ.get("GHOSTSHIP_FREEZE_NOW", "").strip()
    now = parse_time(override) if override else datetime.now(timezone.utc)
    state, description = decide(os.environ.get("GHOSTSHIP_FREEZE", ""), now)
    # One line per value: a newline in the reason would end the output early.
    print(f"state={state}")
    print("description=" + " ".join(description.split()))
    return 0


if __name__ == "__main__":
    sys.exit(main())
