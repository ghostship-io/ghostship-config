#!/usr/bin/env python3
"""The deploy slot: one root-enforced record of who may deploy chill-penguin.

A deploy used to depend on a lead relaying permission between sessions: a
release message was lost and two sessions raced for the same host. This tool
holds the permission itself. One JSON record names the holder, its purpose,
the system generation it started from and the queue behind it, and every
operation takes an exclusive lock on the record, so two sessions can no
longer both believe they may deploy.

Every command prints one JSON object with `schema` and `result`, and exits 0
when it did what was asked, 3 when the slot refuses, 2 when the arguments are
wrong, and 1 when the record itself cannot be read or written.

    status
    acquire --holder H --purpose P [--queue] [--force --reason R]
    release --holder H [--generation N]
    check --holder H

The record lives in `$GHOSTSHIP_DEPLOY_SLOT_DIR` (default
/var/lib/ghostship-deploy-slot): `slot.json` is the record, `ledger.jsonl` is
one line per acquire, release and takeover, and `lock` serializes the
operations. The directory is created 0700 and the files 0600. A write is a
temporary file and a rename, so a reader never sees half a record.

A slot is stale when its holder has not touched it for
`$GHOSTSHIP_DEPLOY_SLOT_STALE_MINUTES` minutes (default 60). A stale slot is
taken over only with `--force --reason R`, and the ledger names the previous
holder and the reason. A queue entry is live for 180 seconds after it was last
seen; the live entry that queued first goes first.

`$GHOSTSHIP_SYSTEM_PROFILE` (default /nix/var/nix/profiles/system) is read to
name the generation the holder started from: a link named `system-412-link`
records 412, and a link that cannot be read records nothing.

`$GHOSTSHIP_DEPLOY_SLOT_NOW` (ISO-8601 Z) pins the clock; the tests use it.
"""

from __future__ import annotations

import datetime
import fcntl
import json
import os
import re
import sys

SCHEMA = 1

DEFAULT_DIRECTORY = "/var/lib/ghostship-deploy-slot"
DEFAULT_PROFILE = "/nix/var/nix/profiles/system"
DEFAULT_STALE_MINUTES = 60
QUEUE_LIVE_SECONDS = 180

HOLDER_MAX = 200
PURPOSE_MAX = 500
REASON_MAX = 500

TIME_FORMAT = "%Y-%m-%dT%H:%M:%SZ"
GENERATION_PATTERN = re.compile(r"system-(\d+)-link")

COMMANDS = {
    "status": frozenset(),
    "acquire": frozenset({"--holder", "--purpose", "--queue", "--force", "--reason"}),
    "release": frozenset({"--holder", "--generation"}),
    "check": frozenset({"--holder"}),
}
VALUE_FLAGS = frozenset({"--holder", "--purpose", "--reason", "--generation"})
BOOLEAN_FLAGS = frozenset({"--queue", "--force"})

USAGE = """usage: deploy-slot status
       deploy-slot acquire --holder H --purpose P [--queue] [--force --reason R]
       deploy-slot release --holder H [--generation N]
       deploy-slot check --holder H"""


class UsageError(Exception):
    """The arguments cannot be acted on; exit 2."""


class Unavailable(Exception):
    """The record or the environment cannot be used; exit 1."""


# --- the clock -------------------------------------------------------------


def parse_time(text):
    if not isinstance(text, str):
        raise ValueError(f"not a time: {text!r}")
    return datetime.datetime.strptime(text, TIME_FORMAT).replace(tzinfo=datetime.timezone.utc)


def format_time(moment):
    return moment.astimezone(datetime.timezone.utc).strftime(TIME_FORMAT)


def current_time():
    override = os.environ.get("GHOSTSHIP_DEPLOY_SLOT_NOW")
    if override:
        try:
            return parse_time(override.strip())
        except ValueError as error:
            raise Unavailable(f"GHOSTSHIP_DEPLOY_SLOT_NOW is not an ISO-8601 Z time: {error}")
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)


def stale_minutes():
    text = os.environ.get("GHOSTSHIP_DEPLOY_SLOT_STALE_MINUTES")
    if text is None or not text.strip():
        return DEFAULT_STALE_MINUTES
    try:
        minutes = int(text.strip())
    except ValueError:
        raise Unavailable("GHOSTSHIP_DEPLOY_SLOT_STALE_MINUTES is not a whole number")
    if minutes < 0:
        raise Unavailable("GHOSTSHIP_DEPLOY_SLOT_STALE_MINUTES must not be negative")
    return minutes


def state_directory():
    return os.environ.get("GHOSTSHIP_DEPLOY_SLOT_DIR") or DEFAULT_DIRECTORY


# --- the generation --------------------------------------------------------


def system_generation():
    """The generation the system profile names, or None when it names none."""
    profile = os.environ.get("GHOSTSHIP_SYSTEM_PROFILE") or DEFAULT_PROFILE
    try:
        target = os.readlink(profile)
    except OSError:
        return None
    matches = GENERATION_PATTERN.findall(target)
    if not matches:
        return None
    return int(matches[-1])


# --- the record ------------------------------------------------------------


def empty_slot():
    return {
        "holder": None,
        "purpose": None,
        "acquired_at": None,
        "last_activity": None,
        "base_generation": None,
        "queue": [],
        "last_release": None,
    }


def load_slot(directory):
    path = os.path.join(directory, "slot.json")
    try:
        with open(path, "r", encoding="utf-8") as handle:
            document = json.load(handle)
    except FileNotFoundError:
        return empty_slot()
    except (OSError, ValueError) as error:
        raise Unavailable(f"cannot read {path}: {error}")
    if not isinstance(document, dict):
        raise Unavailable(f"{path} does not hold a slot record")
    slot = empty_slot()
    for key in slot:
        if key in document:
            slot[key] = document[key]
    if not isinstance(slot["queue"], list):
        slot["queue"] = []
    return slot


def write_slot(directory, slot):
    """Replace slot.json in one rename, so a reader never sees half of it."""
    path = os.path.join(directory, "slot.json")
    temporary = f"{path}.{os.getpid()}.tmp"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(slot, handle, sort_keys=True, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def append_ledger(directory, entry):
    path = os.path.join(directory, "ledger.jsonl")
    line = (json.dumps(entry, sort_keys=True) + "\n").encode("utf-8")
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(descriptor, line)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


class LockedState:
    """The state directory, held under one exclusive lock for an operation."""

    def __init__(self, directory):
        self.directory = directory
        self.descriptor = None

    def __enter__(self):
        try:
            os.makedirs(self.directory, mode=0o700, exist_ok=True)
        except OSError as error:
            raise Unavailable(f"cannot create {self.directory}: {error}")
        lock_path = os.path.join(self.directory, "lock")
        try:
            self.descriptor = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o600)
            fcntl.flock(self.descriptor, fcntl.LOCK_EX)
        except OSError as error:
            raise Unavailable(f"cannot lock {lock_path}: {error}")
        return self

    def __exit__(self, *exception):
        if self.descriptor is not None:
            try:
                fcntl.flock(self.descriptor, fcntl.LOCK_UN)
            finally:
                os.close(self.descriptor)
        return False


# --- the state of the slot -------------------------------------------------


def slot_state(slot, now, seconds):
    holder = slot.get("holder")
    if not holder:
        return "free"
    try:
        last_activity = parse_time(slot.get("last_activity"))
    except (TypeError, ValueError):
        return "stale"
    return "stale" if (now - last_activity).total_seconds() > seconds else "held"


def live_queue(slot, now):
    """The queue entries seen in the last three minutes, earliest first."""
    live = []
    for entry in slot.get("queue") or []:
        if not isinstance(entry, dict):
            continue
        try:
            last_seen = parse_time(entry.get("last_seen"))
        except (TypeError, ValueError):
            continue
        if (now - last_seen).total_seconds() <= QUEUE_LIVE_SECONDS:
            live.append(entry)
    live.sort(key=lambda entry: (entry.get("since") or "", entry.get("holder") or ""))
    return live


def queue_holder(slot, now, holder, purpose):
    """Add the holder to the queue, or refresh the entry it already has."""
    entries = live_queue(slot, now)
    for entry in entries:
        if entry.get("holder") == holder:
            entry["purpose"] = purpose
            entry["last_seen"] = format_time(now)
            break
    else:
        entries.append({
            "holder": holder,
            "purpose": purpose,
            "since": format_time(now),
            "last_seen": format_time(now),
        })
    slot["queue"] = entries


def drop_from_queue(slot, holder, now):
    slot["queue"] = [entry for entry in live_queue(slot, now) if entry.get("holder") != holder]


def queue_document(slot, now):
    return [
        {
            "holder": entry.get("holder"),
            "purpose": entry.get("purpose"),
            "since": entry.get("since"),
            "last_seen": entry.get("last_seen"),
        }
        for entry in live_queue(slot, now)
    ]


def state_fields(slot, now, minutes):
    return {
        "state": slot_state(slot, now, minutes * 60),
        "holder": slot.get("holder"),
        "purpose": slot.get("purpose"),
        "acquired_at": slot.get("acquired_at"),
        "last_activity": slot.get("last_activity"),
        "base_generation": slot.get("base_generation"),
        "stale_minutes": minutes,
        "queue": queue_document(slot, now),
        "last_release": slot.get("last_release"),
    }


def refusal(reason, slot, now, minutes, **extra):
    document = {"schema": SCHEMA, "result": "refused", "reason": reason}
    document.update(state_fields(slot, now, minutes))
    document.update(extra)
    return document


# --- the arguments ---------------------------------------------------------


def validated(value, name, maximum):
    if value is None:
        raise UsageError(f"--{name} is required")
    if "\n" in value or "\r" in value:
        raise UsageError(f"--{name} must be one line")
    text = value.strip()
    if not text:
        raise UsageError(f"--{name} must not be empty")
    if len(text) > maximum:
        raise UsageError(f"--{name} is longer than {maximum} characters")
    return text


def parse_generation(text):
    try:
        generation = int(text.strip())
    except (AttributeError, ValueError):
        raise UsageError("--generation must be a whole number")
    if generation < 0:
        raise UsageError("--generation must not be negative")
    return generation


def parse_arguments(argv):
    if not argv:
        raise UsageError("a command is required")
    if argv[0] in ("-h", "--help"):
        return "help", {}
    command = argv[0]
    if command not in COMMANDS:
        raise UsageError(f"unknown command {command!r}")
    options = {}
    index = 1
    while index < len(argv):
        token = argv[index]
        if token in ("-h", "--help"):
            return "help", {}
        if token in VALUE_FLAGS:
            if token not in COMMANDS[command]:
                raise UsageError(f"{token} is not an option of {command}")
            if index + 1 >= len(argv):
                raise UsageError(f"{token} needs a value")
            options[token] = argv[index + 1]
            index += 2
        elif token in BOOLEAN_FLAGS:
            if token not in COMMANDS[command]:
                raise UsageError(f"{token} is not an option of {command}")
            options[token] = True
            index += 1
        else:
            raise UsageError(f"unexpected argument {token!r}")
    return command, options


# --- the commands ----------------------------------------------------------


def command_status(directory, options, now, minutes):
    with LockedState(directory):
        slot = load_slot(directory)
    document = {"schema": SCHEMA, "result": "status"}
    document.update(state_fields(slot, now, minutes))
    return 0, document


def command_acquire(directory, options, now, minutes):
    holder = validated(options.get("--holder"), "holder", HOLDER_MAX)
    purpose = validated(options.get("--purpose"), "purpose", PURPOSE_MAX)
    force = bool(options.get("--force"))
    reason = None
    if force:
        reason = validated(options.get("--reason"), "reason", REASON_MAX)
    elif "--reason" in options:
        raise UsageError("--reason is only used with --force")
    join_queue = bool(options.get("--queue"))
    generation = system_generation()
    now_text = format_time(now)
    stale_seconds = minutes * 60

    with LockedState(directory):
        slot = load_slot(directory)
        state = slot_state(slot, now, stale_seconds)
        current = slot.get("holder")

        if current is None:
            waiting = live_queue(slot, now)
            if waiting and waiting[0].get("holder") != holder:
                ahead = waiting[0]
                if join_queue:
                    queue_holder(slot, now, holder, purpose)
                    write_slot(directory, slot)
                return 3, refusal(
                    f"queued behind {ahead.get('holder')}: that holder has waited since "
                    f"{ahead.get('since')}", slot, now, minutes,
                    queued_behind=ahead.get("holder"))

            drop_from_queue(slot, holder, now)
            slot.update({
                "holder": holder,
                "purpose": purpose,
                "acquired_at": now_text,
                "last_activity": now_text,
                "base_generation": generation,
            })
            write_slot(directory, slot)
            append_ledger(directory, {
                "time": now_text,
                "event": "acquired",
                "holder": holder,
                "purpose": purpose,
                "generation": generation,
            })
            return 0, {
                "schema": SCHEMA,
                "result": "acquired",
                "state": "held",
                "holder": holder,
                "purpose": purpose,
                "acquired_at": now_text,
                "last_activity": now_text,
                "base_generation": generation,
            }

        if current == holder:
            drop_from_queue(slot, holder, now)
            slot["purpose"] = purpose
            slot["last_activity"] = now_text
            write_slot(directory, slot)
            return 0, {
                "schema": SCHEMA,
                "result": "refreshed",
                "state": "held",
                "holder": holder,
                "purpose": purpose,
                "acquired_at": slot.get("acquired_at"),
                "last_activity": now_text,
                "base_generation": slot.get("base_generation"),
            }

        since = slot.get("acquired_at")
        held_by = slot.get("holder")

        if state == "stale":
            if not force:
                if join_queue:
                    queue_holder(slot, now, holder, purpose)
                    write_slot(directory, slot)
                return 3, refusal(
                    f"the slot held by {held_by} since {since} is stale; take it over with "
                    "--force --reason", slot, now, minutes)
            drop_from_queue(slot, holder, now)
            slot.update({
                "holder": holder,
                "purpose": purpose,
                "acquired_at": now_text,
                "last_activity": now_text,
                "base_generation": generation,
            })
            write_slot(directory, slot)
            append_ledger(directory, {
                "time": now_text,
                "event": "taken_over",
                "holder": holder,
                "purpose": purpose,
                "generation": generation,
                "previous_holder": held_by,
                "reason": reason,
            })
            return 0, {
                "schema": SCHEMA,
                "result": "taken_over",
                "state": "held",
                "holder": holder,
                "purpose": purpose,
                "acquired_at": now_text,
                "last_activity": now_text,
                "base_generation": generation,
                "previous_holder": held_by,
                "reason": reason,
            }

        if join_queue:
            queue_holder(slot, now, holder, purpose)
            write_slot(directory, slot)
        message = f"held by {held_by} since {since} for {slot.get('purpose')}"
        if force:
            message = (f"the slot is held by {held_by} since {since} and is not stale; "
                       "--force does not take over a fresh slot")
        return 3, refusal(message, slot, now, minutes, since=since)


def command_release(directory, options, now, minutes):
    holder = validated(options.get("--holder"), "holder", HOLDER_MAX)
    generation = None
    if "--generation" in options:
        generation = parse_generation(options["--generation"])
    now_text = format_time(now)

    with LockedState(directory):
        slot = load_slot(directory)
        current = slot.get("holder")
        if current is None:
            return 0, {
                "schema": SCHEMA,
                "result": "already_free",
                "state": "free",
                "last_release": slot.get("last_release"),
            }
        if current != holder:
            return 3, refusal(
                f"the slot is held by {current}, not by {holder}", slot, now, minutes)

        if generation is None:
            generation = system_generation()
        purpose = slot.get("purpose")
        last_release = {"holder": holder, "released_at": now_text, "generation": generation}
        slot.update({
            "holder": None,
            "purpose": None,
            "acquired_at": None,
            "last_activity": None,
            "base_generation": None,
            "last_release": last_release,
            "queue": live_queue(slot, now),
        })
        write_slot(directory, slot)
        append_ledger(directory, {
            "time": now_text,
            "event": "released",
            "holder": holder,
            "purpose": purpose,
            "generation": generation,
        })
        return 0, {
            "schema": SCHEMA,
            "result": "released",
            "state": "free",
            "holder": None,
            "last_release": last_release,
        }


def command_check(directory, options, now, minutes):
    holder = validated(options.get("--holder"), "holder", HOLDER_MAX)
    now_text = format_time(now)

    with LockedState(directory):
        slot = load_slot(directory)
        current = slot.get("holder")
        if current is None:
            return 3, refusal("the slot is free", slot, now, minutes)
        if current != holder:
            return 3, refusal(f"the slot is held by {current}", slot, now, minutes)
        slot["last_activity"] = now_text
        slot["queue"] = live_queue(slot, now)
        write_slot(directory, slot)
        return 0, {
            "schema": SCHEMA,
            "result": "ok",
            "state": "held",
            "holder": holder,
            "purpose": slot.get("purpose"),
            "acquired_at": slot.get("acquired_at"),
            "last_activity": now_text,
            "base_generation": slot.get("base_generation"),
        }


HANDLERS = {
    "status": command_status,
    "acquire": command_acquire,
    "release": command_release,
    "check": command_check,
}


def main(argv=None):
    arguments = list(sys.argv[1:] if argv is None else argv)
    try:
        command, options = parse_arguments(arguments)
        if command == "help":
            return emit({"schema": SCHEMA, "result": "help", "usage": USAGE}, 0)
        now = current_time()
        minutes = stale_minutes()
        code, document = HANDLERS[command](state_directory(), options, now, minutes)
        return emit(document, code)
    except UsageError as error:
        return emit({"schema": SCHEMA, "result": "usage", "error": str(error), "usage": USAGE}, 2)
    except Unavailable as error:
        return emit({"schema": SCHEMA, "result": "error", "error": str(error)}, 1)
    except Exception as error:  # a record the tool cannot serve is an error, not a crash
        return emit({"schema": SCHEMA, "result": "error",
                     "error": f"{type(error).__name__}: {error}"}, 1)


def emit(document, code):
    print(json.dumps(document, sort_keys=True))
    return code


if __name__ == "__main__":
    sys.exit(main())
