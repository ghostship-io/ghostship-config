#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  echo 'Run checks in the repository Nix environment: nix develop .#ci -c scripts/check' >&2
  exit 1
fi
if [[ "$(git rev-parse --show-toplevel)" != "$repo_root" ]]; then
  echo 'Run checks from the assigned checkout.' >&2
  exit 1
fi
cd "$repo_root"

if [[ $# -ne 0 && $# -ne 2 ]]; then
  echo "Usage: scripts/check [PR_BASE PR_HEAD]" >&2
  exit 2
fi

shellcheck scripts/check scripts/check-integration
shellcheck -s bash -e SC1091 modules/self-hosted/backup.sh modules/self-hosted/restore-check.sh scripts/activate-host
actionlint
if [[ $# -eq 2 ]]; then
  git diff --check "$1...$2"
fi
git diff --check
git diff --cached --check
python3 scripts/generate-model-dashboards.py --check
python3 scripts/check-test-fixtures.py tests
timeout 110s python3 scripts/check-unit.py
gitleaks dir --redact --no-banner .
printf 'Fast repository checks passed; host evaluation and integration run manually on main.\n'
