# Ghostship Agent Desktop
#
# Extends the LinuxServer Selkies Webtop Ubuntu LXQt image with:
#   - a pinned Camoufox + Playwright Python environment (Rust and C build
#     dependencies stay in the builder stage and never reach the runtime image)
#   - OpenSSH server for key-based GUI automation and software installation
#   - s6 services for the automation API proxy, the browser owners and sshd
#
# The NixOS module builds this image on the target host with a
# content-addressed tag; the build context is this directory.
#
# The base digest is pinned for reproducible rebuilds. Refresh it together
# with the packages below when updating the desktop.

FROM lscr.io/linuxserver/webtop:ubuntu-lxqt@sha256:92db2b409b2d72914d93fec49f0f96d6da9bb9a497d1dd51d1ca9df4cedf94ac AS python-builder

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential \
      libzstd-dev \
      python3-dev \
      python3-venv \
      rustc \
      cargo \
 && rm -rf /var/lib/apt/lists/*

# Camoufox pins Playwright below 1.63; Browser.bind() and multi-client
# BrowserType.connect() require Playwright 1.59 or newer.
# fpgen's model is fetched here and the tree is owned by the container user
# (PUID 3000) because fpgen materializes the model on first use at runtime.
RUN python3 -m venv /opt/ghostship-agent-desktop/venv \
 && /opt/ghostship-agent-desktop/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/ghostship-agent-desktop/venv/bin/pip install --no-cache-dir \
      "camoufox==0.5.8" \
      "playwright==1.62.0" \
 && /opt/ghostship-agent-desktop/venv/bin/python -m fpgen fetch \
 && rm -rf /root/.cache/camoufox \
 && chown -R 3000:3000 /opt/ghostship-agent-desktop

FROM lscr.io/linuxserver/webtop:ubuntu-lxqt@sha256:92db2b409b2d72914d93fec49f0f96d6da9bb9a497d1dd51d1ca9df4cedf94ac

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      openssh-server \
 && rm -rf /var/lib/apt/lists/*

# The desktop does not run audio, cron or a nested Docker daemon; keep those
# s6 services out of the boot bundle entirely.
RUN rm -f \
      /etc/s6-overlay/s6-rc.d/user/contents.d/svc-pulseaudio \
      /etc/s6-overlay/s6-rc.d/user/contents.d/svc-cron \
      /etc/s6-overlay/s6-rc.d/user/contents.d/svc-docker

COPY --from=python-builder /opt/ghostship-agent-desktop/venv /opt/ghostship-agent-desktop/venv
COPY root/ /

RUN chmod 0755 \
      /custom-cont-init.d/* \
      /etc/profile.d/ghostship-desktop.sh \
      /opt/ghostship-agent-desktop/* \
      /etc/s6-overlay/s6-rc.d/svc-agent-desktop-api/run \
      /etc/s6-overlay/s6-rc.d/svc-agent-desktop-browsers/run \
      /etc/s6-overlay/s6-rc.d/svc-agent-desktop-sshd/run \
 && ln -sf /opt/ghostship-agent-desktop/desktop-exec /usr/local/bin/ghostship-desktop-exec
