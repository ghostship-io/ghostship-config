#!/usr/bin/env python3
"""Close agent browser windows whose Ghostship lease has expired.

Usage: chrome-lease-reaper <agent|personal|port>
Environment: CHROME_LEASE_SLACK_SECONDS (default 120)

Each lease is an atomically renewed public run record. Only a record whose
bound target still belongs to the recorded window authorizes closure. Expired
records never grant authority over a reused numeric window id. Unknown windows
are untouched. The chrome-idle service runs this each check.

Stdlib only: the desktop's system python3 has no extra packages.
"""
from __future__ import annotations

import base64
import json
import os
import socket
import sys
import time
import urllib.error
import urllib.request

PORTS = {"agent": 9222, "personal": 9223}
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
from desktop_leases import records, bound_records
RUNS_DIR = os.environ.get("CHROME_RUNS_DIR", "/config/agent-desktop/runs")


def plan(pages, windows, rows, now, slack):
    rows = bound_records(rows, windows)
    protected = {r["chrome_window_id"] for r in rows if r["expires_at"] + slack >= now}
    expired = {r["chrome_window_id"] for r in rows if r["expires_at"] + slack < now} - protected
    result = []
    claimed = set()
    for window in sorted(expired):
        members = {p["targetId"] for p in pages if windows.get(p["targetId"]) == window}
        # Only include separate popup windows made entirely of descendants.
        descendants = set(members)
        while True:
            children = {p["targetId"] for p in pages if p.get("openerId") in descendants}
            if children <= descendants:
                break
            descendants |= children
        for popup_window in {windows.get(t) for t in descendants} - protected - {None}:
            group = {p["targetId"] for p in pages if windows.get(p["targetId"]) == popup_window}
            if group <= descendants:
                members |= group
        result.append((window, sorted(members - claimed)))
        claimed |= members
    return result


class Browser:
    """Minimal browser-websocket DevTools client (text frames, no events)."""

    def __init__(self, port: int):
        self.port = port
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version", timeout=5) as resp:
            ws = json.load(resp)["webSocketDebuggerUrl"]
        path = "/" + ws.split("/", 3)[3]
        self.sock = socket.create_connection(("127.0.0.1", port), timeout=10)
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((f"GET {path} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nUpgrade: websocket\r\n"
                           f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                           "Sec-WebSocket-Version: 13\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise OSError("websocket handshake closed")
            buf += chunk
        head, self.rest = buf.split(b"\r\n\r\n", 1)
        if b" 101 " not in head.split(b"\r\n", 1)[0]:
            raise OSError("websocket handshake refused")
        self.next_id = 0

    def _read(self, k: int) -> bytes:
        while len(self.rest) < k:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise OSError("websocket closed")
            self.rest += chunk
        out, self.rest = self.rest[:k], self.rest[k:]
        return out

    def call(self, method: str, params: dict | None = None) -> dict:
        """Send one command; return its result, or raise LookupError on a CDP error."""
        self.next_id += 1
        data = json.dumps({"id": self.next_id, "method": method, "params": params or {}}).encode()
        mask = os.urandom(4)
        n = len(data)
        if n < 126:
            frame = bytes([0x81, 0x80 | n])
        elif n < 65536:
            frame = bytes([0x81, 0x80 | 126]) + n.to_bytes(2, "big")
        else:
            frame = bytes([0x81, 0x80 | 127]) + n.to_bytes(8, "big")
        self.sock.sendall(frame + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))
        while True:
            b0, b1 = self._read(2)
            size = b1 & 127
            if size == 126:
                size = int.from_bytes(self._read(2), "big")
            elif size == 127:
                size = int.from_bytes(self._read(8), "big")
            payload = self._read(size)
            if b0 & 15 != 1:
                continue
            message = json.loads(payload)
            if message.get("id") == self.next_id:
                if message.get("error"):
                    raise LookupError(message["error"].get("message", "CDP error"))
                return message.get("result") or {}

    def close(self) -> None:
        self.sock.close()


def close_target(port: int, target_id: str) -> bool:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/json/close/{target_id}", timeout=5):
            return True
    except (OSError, urllib.error.URLError):
        return False


def reap(name: str, port: int, slack: int) -> int:
    browser = Browser(port)
    try:
        pages = [t for t in browser.call("Target.getTargets").get("targetInfos", [])
                 if t.get("type") == "page"]
        now = time.time()
        rows = records(RUNS_DIR, name)
        if not any(row["expires_at"] + slack < now for row in rows):
            return 0
        windows = {}
        for page in pages:
            try:
                windows[page["targetId"]] = browser.call(
                    "Browser.getWindowForTarget", {"targetId": page["targetId"]})["windowId"]
            except (LookupError, KeyError):
                pass  # Closed mid-pass or not in a window; next pass retries.
    finally:
        browser.close()
    for window, targets in plan(pages, windows, records(RUNS_DIR, name), time.time(), slack):
        closed = sum(close_target(port, target) for target in targets)
        if closed == len(targets):
            for row in rows:
                if row["chrome_window_id"] != window or row["expires_at"] + slack >= now:
                    continue
                current = next((r for r in records(RUNS_DIR, name) if r["run_id"] == row["run_id"]), None)
                if current == row:
                    for suffix in (".json", ".pause"):
                        try:
                            os.unlink(os.path.join(RUNS_DIR, row["run_id"] + suffix))
                        except OSError:
                            pass
        print(f"[chrome-lease-reaper] {name}: closed expired lease window {window} ({closed} tabs)", flush=True)
    return 0


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("usage: chrome-lease-reaper <agent|personal|port>", file=sys.stderr)
        return 2
    name = argv[1]
    port = PORTS.get(name) or (int(name) if name.isdigit() else 0)
    slack_text = os.environ.get("CHROME_LEASE_SLACK_SECONDS", "120")
    if not port or not slack_text.isdigit():
        print("chrome-lease-reaper: expected agent, personal or a port, and whole-second slack", file=sys.stderr)
        return 2
    try:
        return reap(name, port, int(slack_text))
    except (OSError, ValueError, LookupError) as error:
        print(f"[chrome-lease-reaper] {name}: skipped ({type(error).__name__})", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
