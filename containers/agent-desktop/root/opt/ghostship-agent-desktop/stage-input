#!/usr/bin/python3 -I
"""Attach a virtual mouse and keyboard to a browser stage's seat.

Usage: stage-input   (WAYLAND_DISPLAY and XDG_RUNTIME_DIR name the stage)

A headless compositor output has no input devices, so pages in it report no
fine pointer and no hover, which no real desktop does. This minimal Wayland
client registers one virtual pointer (zwlr_virtual_pointer_manager_v1) and
one virtual keyboard with a US layout (zwp_virtual_keyboard_manager_v1) and
holds them until the stage exits. It never sends input: agents and the
viewer drive pages through target-scoped DevTools input.
"""
from __future__ import annotations

import os
import socket
import struct
import sys

KEYMAP = b"""xkb_keymap {
  xkb_keycodes { include "evdev+aliases(qwerty)" };
  xkb_types { include "complete" };
  xkb_compat { include "complete" };
  xkb_symbols { include "pc+us+inet(evdev)" };
};
\0"""


class Wayland:
    def __init__(self, path: str):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.next_id = 2
        self.buffer = b""

    def new_id(self) -> int:
        value, self.next_id = self.next_id, self.next_id + 1
        return value

    @staticmethod
    def string(value: str) -> bytes:
        data = value.encode() + b"\0"
        return struct.pack("<I", len(data)) + data + b"\0" * (-len(data) % 4)

    def send(self, obj: int, opcode: int, payload: bytes = b"", fds: list[int] | None = None) -> None:
        message = struct.pack("<II", obj, ((8 + len(payload)) << 16) | opcode) + payload
        if fds:
            socket.send_fds(self.sock, [message], fds)
        else:
            self.sock.sendall(message)

    def events(self):
        while True:
            while len(self.buffer) >= 8:
                obj, word = struct.unpack_from("<II", self.buffer)
                size = word >> 16
                if len(self.buffer) < size:
                    break
                body, self.buffer = self.buffer[8:size], self.buffer[size:]
                yield obj, word & 0xFFFF, body
            data = self.sock.recv(65536)
            if not data:
                return
            self.buffer += data


def main() -> int:
    display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
    path = display if display.startswith("/") else os.path.join(os.environ["XDG_RUNTIME_DIR"], display)
    wl = Wayland(path)
    registry = wl.new_id()
    wl.send(1, 1, struct.pack("<I", registry))          # wl_display.get_registry
    callback = wl.new_id()
    wl.send(1, 0, struct.pack("<I", callback))          # wl_display.sync
    globals_: dict[str, tuple[int, int]] = {}
    for obj, opcode, body in wl.events():
        if obj == registry and opcode == 0:              # wl_registry.global
            name, length = struct.unpack_from("<II", body)
            interface = body[8:8 + length - 1].decode()
            (version,) = struct.unpack_from("<I", body, 8 + length + (-length % 4))
            globals_.setdefault(interface, (name, version))
        elif obj == callback:                            # wl_callback.done
            break
    wanted = ("wl_seat", "zwlr_virtual_pointer_manager_v1", "zwp_virtual_keyboard_manager_v1")
    missing = [name for name in wanted if name not in globals_]
    if missing:
        print(f"stage-input: compositor lacks {', '.join(missing)}", file=sys.stderr)
        return 1
    bound = {}
    for interface in wanted:
        name, version = globals_[interface]
        bound[interface] = wl.new_id()
        wl.send(registry, 0, struct.pack("<I", name) + wl.string(interface)
                + struct.pack("<II", min(version, 1 if interface != "wl_seat" else 5), bound[interface]))
    seat = bound["wl_seat"]
    pointer = wl.new_id()
    wl.send(bound["zwlr_virtual_pointer_manager_v1"], 0, struct.pack("<II", seat, pointer))
    keyboard = wl.new_id()
    wl.send(bound["zwp_virtual_keyboard_manager_v1"], 0, struct.pack("<II", seat, keyboard))
    keymap = os.memfd_create("ghostship-keymap")
    os.write(keymap, KEYMAP)
    wl.send(keyboard, 0, struct.pack("<II", 1, len(KEYMAP)), [keymap])  # keymap(XKB_V1, fd, size)
    os.close(keymap)
    for _ in wl.events():                                # hold the devices; drain events
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
