#!/usr/bin/python3 -I
"""Attach a virtual mouse and keyboard to a browser stage's seat.

Usage: stage-input   (WAYLAND_DISPLAY and XDG_RUNTIME_DIR name the stage)

A headless compositor output has no input devices, so pages in it report no
fine pointer and no hover, which no real desktop does. This minimal Wayland
client registers one virtual pointer (zwlr_virtual_pointer_manager_v1) and
one virtual keyboard with a US layout (zwp_virtual_keyboard_manager_v1) and
holds them until the stage exits. It never sends input: agents and the
viewer drive pages through target-scoped DevTools input.
"""
from __future__ import annotations

import sys

sys.path.insert(0, "/opt/ghostship-agent-desktop/lib")
from ghostship_wl import VirtualInput, socket_path  # noqa: E402


def main() -> int:
    try:
        devices = VirtualInput(socket_path())
    except OSError as exc:
        print(f"stage-input: {exc}", file=sys.stderr)
        return 1
    devices.hold()
    return 0


if __name__ == "__main__":
    sys.exit(main())
