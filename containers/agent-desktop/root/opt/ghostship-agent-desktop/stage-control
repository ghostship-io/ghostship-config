#!/usr/bin/python3 -I
"""Full Chrome windows for a browser stage: each window on its own output.

Usage: stage-control <agent|personal>   (WAYLAND_DISPLAY, SWAYSOCK and
       XDG_RUNTIME_DIR name the stage; run-chrome starts it)

Agents drive page content with target-scoped DevTools input, which needs no
compositor focus. The browser's own UI (tab strip, toolbar, extension popups,
menus) needs real pointer and keyboard input, which goes to the focused
window. Chrome listens to one Wayland seat, so this stage has one focus:

- Each Chrome window gets a headless output of its own (1920x1080, as every
  stage output), so it can be captured whole, popups included. All outputs
  sit at 0,0, so every window reports the single-screen geometry a stage
  window always had (screen.availLeft 0, as the fingerprint baseline). Only
  the output of the window holding the focus lease moves to x=1920 while the
  lease lasts, because pointer input finds its target by layout position.
- New windows map on a hidden workspace ("stage-new") and never take focus;
  when nobody uses the UI, focus rests on an empty workspace ("idle").
- UI input takes a focus lease on one window: focus moves only between that
  window and "idle", so no other window is ever activated or deactivated
  (deactivation blurs the field an agent may be typing into). A lease lasts
  until its holder releases it or LEASE_IDLE seconds pass without input, so
  a menu or extension popup stays open between an agent's calls.
- Sway windows are paired with Chrome windows (DevTools window ids) so the
  viewer knows which run a window belongs to: by the run's home-tab URL when
  sway sees it as the window title, else by the window title matching tab
  titles in exactly one Chrome window, else by elimination. Pairs are sticky;
  an ambiguous window stays unpaired (the viewer then shows page content
  only) rather than risk showing another run's window.

Socket /config/agent-desktop/runs/stage-<identity>.sock, one JSON request per
line: windows | frame {window, max_edge, quality} | input {window, actions,
actor} | release {window}, where window is {con: <sway id>} (the viewer) or
{chrome_window: <DevTools window id>, run_id} (agents). Agent input marks the
window's tabs busy, then fails with "paused" while a person has taken the run
over, as the browser gate does. `stage-control call <identity>` sends one
request read from stdin (agents use it over SSH). It also holds the stage's
virtual pointer and keyboard, so pages see a fine
pointer and hover.
"""
from __future__ import annotations

import asyncio
import base64
import io
import json
import os
import re
import socket
import struct
import subprocess
import sys
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "lib"))
sys.path.insert(0, os.path.join(HERE, "tools"))
from cdp_ws import Cdp, CdpError  # noqa: E402
from ghostship_actions import Actions, InputError  # noqa: E402
from ghostship_wl import VirtualInput, socket_path  # noqa: E402

RUNS = os.environ.get("STAGE_CONTROL_RUNS", "/config/agent-desktop/runs")
PORTS = {"agent": 9222, "personal": 9223}
OUTPUT_W, OUTPUT_H = 1920, 1080
LEASE_IDLE = 20.0
ANCHOR = re.compile(r"about:blank#ghostship-window-([A-Za-z0-9_-]{1,64})")
MAGIC = b"i3-ipc"
RUN_COMMAND, GET_WORKSPACES, SUBSCRIBE, GET_OUTPUTS, GET_TREE = 0, 1, 2, 3, 4


def log(message: str) -> None:
    print(f"[stage-control] {message}", file=sys.stderr, flush=True)


class StageError(Exception):
    def __init__(self, kind: str, message: str):
        super().__init__(message)
        self.kind = kind


class Ipc:
    """A minimal sway IPC client (one request at a time)."""

    def __init__(self, path: str):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.lock = threading.Lock()

    def _read(self) -> tuple[int, object]:
        head = b""
        while len(head) < 14:
            chunk = self.sock.recv(14 - len(head))
            if not chunk:
                raise ConnectionError("sway closed the IPC socket")
            head += chunk
        length, kind = struct.unpack("<II", head[6:])
        body = b""
        while len(body) < length:
            chunk = self.sock.recv(length - len(body))
            if not chunk:
                raise ConnectionError("sway closed the IPC socket")
            body += chunk
        return kind, json.loads(body)

    def request(self, kind: int, payload: str = "") -> object:
        data = payload.encode()
        with self.lock:
            self.sock.sendall(MAGIC + struct.pack("<II", len(data), kind) + data)
            return self._read()[1]

    def command(self, text: str) -> None:
        replies = self.request(RUN_COMMAND, text)
        failed = [r.get("error") for r in replies if not r.get("success")]
        if failed:
            raise StageError("unavailable", f"sway refused {text!r}: {failed[0]}")


class Stage:
    def __init__(self, identity: str):
        self.identity = identity
        self.env = dict(os.environ)
        self.ipc = Ipc(os.environ["SWAYSOCK"])
        self.devices = VirtualInput(socket_path())
        self.windows: dict[int, dict] = {}   # con id -> {output, run_id}
        self.outputs: list[str] = []         # per-window outputs, in layout order
        self.lease: dict | None = None       # {con, actor, last}
        self.lock = threading.Lock()         # placement and input
        self.base_output = None
        self.loop: asyncio.AbstractEventLoop | None = None
        self.cdp: Cdp | None = None
        self.target_windows: dict[str, int] = {}  # CDP target id -> Chrome window id
        self.pairs: dict[int, int] = {}            # sway con id -> Chrome window id (sticky)
        self.anchor_titles: dict[int, str] = {}    # sway con id -> run id seen in its title

    # ---- layout -------------------------------------------------------------
    def setup(self) -> None:
        outputs = self.ipc.request(GET_OUTPUTS)
        self.base_output = outputs[0]["name"]
        self.ipc.command(f"workspace idle output {self.base_output}")
        self.ipc.command(f"workspace stage-new output {self.base_output}")
        self.ipc.command("workspace idle")
        for con in self.tree_windows():
            # After a restart, adopt windows that already have their own output.
            if con["output"] != self.base_output and con.get("workspace") == f"w-{con['output']}":
                self.windows[con["id"]] = {"output": con["output"]}
                if con["output"] not in self.outputs:
                    self.outputs.append(con["output"])
            else:
                self.place(con["id"], con.get("name") or "")

    def tree_windows(self) -> list[dict]:
        found = []

        def walk(node, output=None, workspace=None):
            if node.get("type") == "output":
                output = node["name"]
            if node.get("type") == "workspace":
                workspace = node["name"]
            if node.get("pid"):
                found.append(dict(node, output=output, workspace=workspace))
            for child in node.get("nodes", []) + node.get("floating_nodes", []):
                walk(child, output, workspace)

        walk(self.ipc.request(GET_TREE))
        return found

    def layout_extent(self) -> tuple[int, int]:
        outputs = [o for o in self.ipc.request(GET_OUTPUTS) if o.get("active")]
        return (max(o["rect"]["x"] + o["rect"]["width"] for o in outputs),
                max(o["rect"]["y"] + o["rect"]["height"] for o in outputs))

    def free_output(self) -> str:
        used = {w["output"] for w in self.windows.values()}
        for name in self.outputs:
            if name not in used:
                return name
        before = {o["name"] for o in self.ipc.request(GET_OUTPUTS)}
        # A new output opens on a workspace assigned to it, so name its
        # workspace first: switching workspaces would move focus.
        numbers = [int(n.rsplit("-", 1)[1]) for n in before if re.fullmatch(r"HEADLESS-\d+", n)]
        expected = f"HEADLESS-{max(numbers, default=0) + 1}"
        self.ipc.command(f"workspace w-{expected} output {expected}")
        self.ipc.command("create_output")
        name = next(o["name"] for o in self.ipc.request(GET_OUTPUTS) if o["name"] not in before)
        self.ipc.command(f"output {name} resolution {OUTPUT_W}x{OUTPUT_H} position 0 0")
        visible = next(w["name"] for w in self.ipc.request(GET_WORKSPACES) if w["output"] == name and w["visible"])
        if visible != f"w-{name}":
            self.ipc.command(f"rename workspace {visible} to w-{name}")
        self.outputs.append(name)
        return name

    def place(self, con: int, title: str) -> None:
        with self.lock:
            if con in self.windows:
                return
            output = self.free_output()
            self.windows[con] = {"output": output}
            # Tiled on its own workspace: the gaps (browser-sway.conf) keep it
            # at 1600x900 in the top left, and tiled windows stay with their
            # workspace's output wherever the output is placed.
            self.ipc.command(f"[con_id={con}] floating disable, move container to workspace w-{output}")
            log(f"window {con} -> {output}")

    def forget(self, con: int) -> None:
        with self.lock:
            info = self.windows.pop(con, None)
            self.pairs.pop(con, None)
            self.anchor_titles.pop(con, None)
            if self.lease and self.lease["con"] == con:
                self.lease = None
                self.ipc.command("workspace idle")
            if info:  # the output waits at 0,0 for the next window
                self.ipc.command(f"output {info['output']} position 0 0")

    def watch(self) -> None:
        """Place every new window as sway maps it (blocking; runs in a thread)."""
        events = Ipc(os.environ["SWAYSOCK"])
        events.request(SUBSCRIBE, json.dumps(["window"]))
        while True:
            _, event = events._read()
            change, container = event.get("change"), event.get("container") or {}
            if not container.get("pid"):
                continue
            try:
                match = ANCHOR.search(container.get("name") or "")
                if match:
                    self.anchor_titles[container["id"]] = match.group(1)
                if change == "new":
                    self.place(container["id"], container.get("name") or "")
                elif change == "close":
                    self.forget(container["id"])
            except (StageError, OSError, StopIteration) as exc:
                log(f"window {container.get('id')} {change}: {exc}")

    # ---- Chrome window ids (DevTools Target/Browser domains only) ----------
    async def _chrome_windows(self) -> dict[int, list[dict]]:
        if self.cdp is None or self.cdp._task.done():
            self.cdp = await asyncio.wait_for(Cdp.connect(PORTS[self.identity]), 5)
            self.target_windows.clear()
        infos = (await self.cdp.send("Target.getTargets", {}, timeout=10)).get("targetInfos", [])
        pages = [info for info in infos if info.get("type") == "page"]
        live = {info["targetId"] for info in pages}
        for tid in list(self.target_windows):
            if tid not in live:
                self.target_windows.pop(tid)
        groups: dict[int, list[dict]] = {}
        for info in pages:
            tid = info["targetId"]
            if tid not in self.target_windows:
                try:
                    reply = await self.cdp.send("Browser.getWindowForTarget", {"targetId": tid}, timeout=5)
                except CdpError:
                    continue
                self.target_windows[tid] = reply["windowId"]
            groups.setdefault(self.target_windows[tid], []).append(info)
        return groups

    def chrome_windows(self) -> dict[int, list[dict]]:
        try:
            return asyncio.run_coroutine_threadsafe(self._chrome_windows(), self.loop).result(15)
        except Exception as exc:  # Chrome restarting or busy: report windows without run ids
            log(f"chrome windows: {type(exc).__name__}")
            return {}

    # ---- reads --------------------------------------------------------------
    def list_windows(self) -> list[dict]:
        nodes = sorted((n for n in self.tree_windows() if n["id"] in self.windows), key=lambda n: n["id"])
        groups = self.chrome_windows()
        paired = self.pair(nodes, groups)
        out = []
        for node in nodes:
            rect = node["rect"]
            window_id = paired.get(node["id"])
            targets = groups.get(window_id, [])
            run_id = self.run_of(targets)
            out.append({"con": node["id"], "title": (node.get("name") or "")[:300], "chrome_window": window_id,
                        "run_id": run_id, "targets": [t["targetId"] for t in targets],
                        "output": self.windows[node["id"]]["output"], "width": rect["width"],
                        "height": rect["height"], "focused": bool(node.get("focused")),
                        "lease": bool(self.lease and self.lease["con"] == node["id"])})
        return out

    @staticmethod
    def run_of(targets: list[dict]) -> str | None:
        for target in targets:
            match = ANCHOR.fullmatch(target.get("url", "").split(".")[0])
            if match:
                return match.group(1)
        return None

    def pair(self, nodes: list[dict], groups: dict[int, list[dict]]) -> dict[int, int]:
        """Sway con id -> Chrome window id, extending the sticky pairs where it is unambiguous."""
        if not groups:
            return {}
        cons = {n["id"]: n for n in nodes}
        for con, window in list(self.pairs.items()):
            if con not in cons or window not in groups:
                self.pairs.pop(con)
        by_run = {self.run_of(targets): window for window, targets in groups.items() if self.run_of(targets)}
        for con, run in self.anchor_titles.items():
            if con in cons and con not in self.pairs and by_run.get(run) not in self.pairs.values():
                if run in by_run:
                    self.pairs[con] = by_run[run]
        while True:
            free_cons = [c for c in cons if c not in self.pairs]
            free_windows = [w for w in groups if w not in self.pairs.values()]
            if not free_cons or not free_windows:
                break
            if len(free_cons) == 1 and len(free_windows) == 1 and len(cons) == len(groups):
                self.pairs[free_cons[0]] = free_windows[0]
                break
            matches = {}
            for con in free_cons:
                title = cons[con].get("name") or ""
                if title.endswith(" - Google Chrome"):
                    title = title[: -len(" - Google Chrome")]
                matches[con] = [w for w in free_windows if any(t.get("title") == title for t in groups[w])]
            progress = False
            for con, candidates in matches.items():
                if len(candidates) == 1 and sum(candidates[0] in other for other in matches.values()) == 1:
                    self.pairs[con] = candidates[0]
                    progress = True
            if not progress:
                break
        return dict(self.pairs)

    def window_rect(self, con: int) -> dict:
        for node in self.tree_windows():
            if node["id"] == con:
                return node["rect"]
        raise StageError("not_found", "no such window")

    def frame(self, con: int, max_edge: int, quality: int) -> dict:
        from PIL import Image
        info = self.windows.get(con)
        if info is None:
            raise StageError("not_found", "no such window")
        proc = subprocess.run(["grim", "-o", info["output"], "-t", "ppm", "-"], capture_output=True,
                              timeout=10, env=self.env)
        if proc.returncode:
            raise StageError("unavailable", "screen capture failed")
        image = Image.open(io.BytesIO(proc.stdout)).convert("RGB")
        # Crop the empty part of the output: the window sits at its top left,
        # and menus or popups that extend past it keep the margin they cover.
        rect = self.window_rect(con)
        right, bottom = min(rect["width"], image.width), min(rect["height"], image.height)
        mask = image.convert("L").point(lambda v: 255 if v > 3 else 0)
        side = mask.crop((right, 0, image.width, image.height)).getbbox()
        below = mask.crop((0, bottom, image.width, image.height)).getbbox()
        if side:
            right += side[2]
        if below:
            bottom += below[3]
        image = image.crop((0, 0, right, bottom))
        width, height = image.size
        scale = min(1.0, max_edge / max(image.size))
        if scale < 1.0:
            image = image.resize((max(1, int(width * scale)), max(1, int(height * scale))), Image.BILINEAR)
        out = io.BytesIO()
        image.save(out, "JPEG", quality=quality)
        return {"con": con, "width": width, "height": height, "image_width": image.width,
                "image_height": image.height, "jpeg": base64.b64encode(out.getvalue()).decode(), "at": time.time()}

    # ---- input and the focus lease -----------------------------------------
    def _focus_idle(self) -> None:
        """End the lease's focus: idle gets focus, the leased output goes back to 0,0."""
        self.ipc.command("workspace idle")
        if self.lease:
            output = self.windows.get(self.lease["con"], {}).get("output")
            if output:
                self.ipc.command(f"output {output} position 0 0")

    def _take(self, con: int, actor: str) -> None:
        now = time.monotonic()
        lease = self.lease
        if lease and lease["con"] != con:
            if now - lease["last"] < LEASE_IDLE:
                who = "an agent" if lease["actor"] == "agent" else "a person"
                raise StageError("busy", f"{who} is using another window's browser controls; try again shortly")
            self._focus_idle()
            self.lease = None
        if not self.lease:
            self.ipc.command(f"output {self.windows[con]['output']} position {OUTPUT_W} 0")
            self.ipc.command(f"[con_id={con}] focus")
            self.lease = {"con": con, "actor": actor, "last": now}
        self.lease.update(actor=actor, last=now)

    def release(self, con: int | None = None) -> None:
        with self.lock:
            if self.lease and (con is None or self.lease["con"] == con):
                self._focus_idle()
                self.lease = None

    def expire(self) -> None:
        with self.lock:
            lease = self.lease
            if lease and time.monotonic() - lease["last"] >= LEASE_IDLE:
                self._focus_idle()
                self.lease = None

    def input(self, con: int, actions: list, actor: str, run_id: str | None = None,
              targets: list[str] | None = None) -> dict:
        if not isinstance(actions, list) or not 1 <= len(actions) <= 50:
            raise ValueError("actions must be a list of 1-50 actions")
        if con not in self.windows:
            raise StageError("not_found", "no such window")
        if actor == "agent":
            return self._agent_input(con, actions, run_id, targets or [])
        return self._input(con, actions, actor)

    def _agent_input(self, con: int, actions: list, run_id: str | None, targets: list[str]) -> dict:
        """Mark the window's tabs busy, then refuse while a person holds the run (the gate's order)."""
        busy = [os.path.join(RUNS, "busy", t) for t in targets if re.fullmatch(r"[A-Za-z0-9]{1,64}", t)]
        os.makedirs(os.path.join(RUNS, "busy"), mode=0o700, exist_ok=True)
        for path in busy:
            open(path, "w").close()
        try:
            paused = run_id and os.path.lexists(os.path.join(RUNS, f"{run_id}.pause"))
            if paused or any(os.path.lexists(os.path.join(RUNS, "paused", t)) for t in targets
                             if re.fullmatch(r"[A-Za-z0-9]{1,64}", t)):
                raise StageError("paused", "a person took over this window; wait until they resume it")
            return self._input(con, actions, "agent")
        finally:
            for path in busy:
                try:
                    os.unlink(path)
                except FileNotFoundError:
                    pass

    def _input(self, con: int, actions: list, actor: str) -> dict:
        with self.lock:
            self._take(con, actor)
            try:
                rect = self.window_rect(con)
                output = next(o for o in self.ipc.request(GET_OUTPUTS) if o["name"] == self.windows[con]["output"])
                runner = Actions(self.devices, self.env, OUTPUT_W, OUTPUT_H,
                                 origin=(output["rect"]["x"], output["rect"]["y"]), extent=self.layout_extent())
                results = []
                for action in actions:
                    if not isinstance(action, dict):
                        raise ValueError("each action is an object")
                    results.append(runner.act(action))
                return {"con": con, "results": results, "window": [rect["width"], rect["height"]]}
            except InputError as exc:
                raise StageError("unavailable", str(exc)) from None
            finally:
                if self.lease and self.lease["con"] == con:
                    self.lease["last"] = time.monotonic()

    # ---- socket ---------------------------------------------------------------
    def resolve(self, request: dict) -> tuple[int, dict | None]:
        """The sway con a request names: directly, or by an agent's Chrome window id and run."""
        con = request.get("con")
        if isinstance(con, int):
            return con, None
        chrome_window = request.get("chrome_window")
        if not isinstance(chrome_window, int):
            raise ValueError("name the window by con or chrome_window")
        for window in self.list_windows():
            if window["chrome_window"] == chrome_window:
                if request.get("run_id") and window["run_id"] not in (None, request["run_id"]):
                    raise StageError("invalid_request", "that window belongs to another run")
                return window["con"], window
        raise StageError("not_found", "this window is not on screen yet; try again in a moment")

    def handle(self, request: dict) -> dict:
        op = request.get("op")
        if op == "windows":
            return {"windows": self.list_windows()}
        con, window = self.resolve(request)
        if op == "frame":
            return self.frame(con, min(max(int(request.get("max_edge", 1920)), 160), 3840),
                              min(max(int(request.get("quality", 70)), 20), 95))
        if op == "input":
            actor = request.get("actor", "agent")
            if actor not in ("agent", "human"):
                raise ValueError("actor must be agent or human")
            if actor == "agent" and window is None:
                window = next((w for w in self.list_windows() if w["con"] == con), {})
            return self.input(con, request.get("actions"), actor, run_id=request.get("run_id"),
                              targets=(window or {}).get("targets"))
        if op == "release":
            self.release(con)
            return {"released": True}
        raise ValueError("unknown op")


async def serve(stage: Stage, path: str) -> None:
    loop = asyncio.get_running_loop()
    stage.loop = loop

    async def on_client(reader, writer):
        try:
            line = await asyncio.wait_for(reader.readline(), 30)
            try:
                request = json.loads(line)
                if not isinstance(request, dict):
                    raise ValueError("bad request")
                reply = dict(await loop.run_in_executor(None, stage.handle, request), ok=True)
            except StageError as exc:
                reply = {"ok": False, "error": {"kind": exc.kind, "message": str(exc)}}
            except (ValueError, KeyError, TypeError, OSError, subprocess.TimeoutExpired) as exc:
                reply = {"ok": False, "error": {"kind": "invalid_request", "message": str(exc)[:300] or "bad request"}}
            writer.write(json.dumps(reply).encode() + b"\n")
            await writer.drain()
        except (asyncio.TimeoutError, ConnectionError):
            pass
        finally:
            writer.close()

    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    old = os.umask(0o077)
    try:
        server = await asyncio.start_unix_server(on_client, path, limit=1 << 20)
    finally:
        os.umask(old)

    async def expire():
        while True:
            await asyncio.sleep(1)
            await loop.run_in_executor(None, stage.expire)

    asyncio.ensure_future(expire())
    async with server:
        await server.serve_forever()


def call(identity: str) -> int:
    """One request from stdin to the running stage-control; prints its JSON reply."""
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(120)
    try:
        request = json.loads(sys.stdin.read())
        if not isinstance(request, dict):
            raise ValueError("request must be an object")
        request["actor"] = "agent"  # only the viewer speaks for a person
        sock.connect(os.path.join(RUNS, f"stage-{identity}.sock"))
        sock.sendall(json.dumps(request).encode() + b"\n")
        data = b""
        while not data.endswith(b"\n"):
            chunk = sock.recv(1 << 20)
            if not chunk:
                break
            data += chunk
        print(data.decode().strip() or json.dumps({"ok": False, "error": {"kind": "unavailable",
                                                                          "message": "no reply"}}))
        return 0
    except (OSError, ValueError) as exc:
        print(json.dumps({"ok": False, "error": {"kind": "unavailable",
                                                 "message": f"browser stage unavailable: {type(exc).__name__}"}}))
        return 1


def main() -> int:
    if len(sys.argv) == 3 and sys.argv[1] == "call" and sys.argv[2] in ("agent", "personal"):
        return call(sys.argv[2])
    identity = sys.argv[1] if len(sys.argv) > 1 else ""
    if identity not in ("agent", "personal"):
        print("usage: stage-control <agent|personal> | stage-control call <agent|personal> < request.json",
              file=sys.stderr)
        return 2
    stage = Stage(identity)
    stage.setup()
    threading.Thread(target=stage.watch, daemon=True).start()
    threading.Thread(target=stage.devices.hold, daemon=True).start()
    log(f"{identity} stage ready")
    asyncio.run(serve(stage, os.path.join(RUNS, f"stage-{identity}.sock")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
