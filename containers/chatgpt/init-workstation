#!/usr/bin/env bash
set -euo pipefail
: "${GHOSTSHIP_TOOLS:?Nix workstation closure is required}"
ln -sfn "$GHOSTSHIP_TOOLS" /opt/ghostship-tools
install -d -m 0755 /etc/nix /nix/var/nix/daemon-socket /workspace /config/Transfers
install -d -m 0755 -o abc -g abc /config/.local/bin /config/.local/state/chatgpt /config/.config/supervisor /config/.config/openbox /config/Transfers
getent group nixbld >/dev/null || groupadd -g 30000 nixbld
for i in $(seq 1 16); do
  getent passwd "nixbld$i" >/dev/null || useradd -u "$((30000+i))" -g nixbld -G nixbld -M -d /var/empty -s /usr/sbin/nologin "nixbld$i"
done
cat > /etc/nix/nix.conf <<'CONF'
experimental-features = nix-command flakes
sandbox = false
allowed-users = root abc
trusted-users = root
build-users-group = nixbld
max-jobs = 2
cores = 4
CONF
cat > /etc/profile.d/ghostship.sh <<'CONF'
export PATH="/opt/ghostship-tools/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:$PATH"
export NIX_REMOTE=daemon
export NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
CONF
# The session launches native app windows, browser windows, and terminal windows.
# Do not force transient dialogs to fullscreen or remove their window controls.
cp /defaults/autostart /config/.config/openbox/autostart
chown abc:abc /config/.config/openbox/autostart
# Replace only the transport dashboard, leaving its pinned streaming core intact.
cp /opt/ghostship-chatgpt/web/* /usr/share/selkies/web/
update-chatgpt apply
ln -sfn /var/lib/chatgpt-updates/status /usr/share/selkies/web/update-status.txt
