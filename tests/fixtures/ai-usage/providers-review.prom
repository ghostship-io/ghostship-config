# The review fixture of the Providers page.
#
# Every state the page has to show, with the metrics the collector publishes:
# a route ahead of the pace, a route on it, a route behind it, a spent route,
# a route whose limits are unknown, a route the provider publishes as a
# promotion, a route reserved for 3D work, a route in the free quality band,
# and the three states of an inferred capacity: no limit seen, a limit in
# its window, and a limit that is spent.
#
# The counts are the counts of a live day: about six bulk winners, ten free
# winners, two frontier routes, three routes in the 3D tier and thirteen
# providers, so the page is sized for the rows it really has.
#
# The samples carry no timestamp: the store stamps them on import, so the
# freshness window of the dashboard sees one collection.

ghostship_ai_collection_duration_seconds 1
ghostship_ai_collection_timestamp_seconds 1790000000

# The runtime policy that carries the static worker routes was read. The
# selection table counts only the series of the newest scrape, and this
# gauge marks it: it is published on every collection, one or zero.
ghostship_ai_static_route_policy_ok 1

# The routing is off: the owner has not approved it.
ghostship_ai_routing_enabled 0

# --- The static route table ------------------------------------------------
# The owner's static selection, read while the routing is off. One info row
# per route, and the capacity the routing snapshot measured for that route:
# the share left, the Paced Availability, and the reset of its binding
# window. A route the snapshot does not carry (Beam Free) keeps its info row
# and publishes no capacity series at all.
ghostship_ai_static_route_info{row="1",role="Bulk 1",provider="ollama",model="minimax-m3.1-flash",display_name="MiniMax-M3.1-Flash",used_for="Narrow implementation (1st), Research (2nd)"} 1
ghostship_ai_static_route_remaining_ratio{row="1"} 0.4129
ghostship_ai_static_route_paced_availability{row="1"} -0.033
ghostship_ai_static_route_reset_timestamp_seconds{row="1"} 1792713677
ghostship_ai_static_route_info{row="2",role="Bulk 2",provider="ollama",model="deepseek-v4.1-flash:1017",display_name="DeepSeek V4.1 Flash 1017",used_for="Narrow implementation (2nd), Research (1st)"} 1
ghostship_ai_static_route_remaining_ratio{row="2"} 0.63
ghostship_ai_static_route_paced_availability{row="2"} -0.05
ghostship_ai_static_route_reset_timestamp_seconds{row="2"} 1792720877
ghostship_ai_static_route_info{row="3",role="Large",provider="codex",model="gpt-6.1-sol",display_name="GPT-6.1-Sol",used_for="Large implementation (1st)"} 1
ghostship_ai_static_route_remaining_ratio{row="3"} 0.99
ghostship_ai_static_route_paced_availability{row="3"} 0.012
ghostship_ai_static_route_reset_timestamp_seconds{row="3"} 1793048477
ghostship_ai_static_route_info{row="4",role="Deploys",provider="opencode-go",model="beam-free",display_name="Beam Free",used_for="Deploys (1st), Research (3rd)"} 1
ghostship_ai_static_route_remaining_ratio{row="4"} 1.0
ghostship_ai_static_route_info{row="5",role="Deploys",provider="ollama",model="beam",display_name="Beam 1.0 501B A23B",used_for="Deploys (2nd)"} 1
ghostship_ai_static_route_remaining_ratio{row="5"} 0.94
ghostship_ai_static_route_paced_availability{row="5"} 0.001
ghostship_ai_static_route_reset_timestamp_seconds{row="5"} 1792724477

