ghostship_ai_model_rank{tier="bulk",provider="groq",model="llama-4.3-70b"} 5
ghostship_ai_model_rank{tier="bulk",provider="nvidia",model="qwen3.8-max"} 6
ghostship_ai_model_rank{tier="bulk",provider="grok",model="grok-4.6"} 7

# The promotion route: the provider publishes it as unlimited for a limited
# time, so it has no window, no pace and no measured allowance.
ghostship_ai_entitlement_info{provider="opencode-go",account="default",model="minimax_minimax-m3.1-flash_free",window="unlimited__limited-time_promotion_",quota="free-unlimited",source="published",entitlement="opencode-go:default:minimax_minimax-m3.1-flash_free:unlimited (limited-time promotion):free-unlimited",basis="promotion",ends_at=""} 1
ghostship_ai_model_capacity_basis{provider="opencode-go",model="minimax_minimax-m3.1-flash_free",basis="published",state="",window="unlimited__limited-time_promotion_",scope="model",unit="requests",weights=""} 1

