# The review fixture of the Providers page.
#
# Every state the page must show, with the metrics the collector publishes:
# a route ahead of the pace, a route on it, a route behind it, a spent route,
# a route whose limits are unknown, a route the provider publishes as a
# promotion, a route reserved for 3D work, a route in the free quality band,
# and a provider whose account is spent.
#
# The samples carry no timestamp: the store stamps them on import, so the
# freshness window of the dashboard sees one collection.

ghostship_ai_collection_duration_seconds 1
ghostship_ai_collection_timestamp_seconds 1790000000

# The routing is off: the owner has not approved it.
ghostship_ai_routing_enabled 0

# --- Bulk ------------------------------------------------------------------
# The next coding job goes to the first row. The order is the collector's.
ghostship_ai_model_winner_position{tier="bulk",provider="opencode-go",model="minimax_minimax-m3.1-flash_free"} 1
ghostship_ai_model_winner_position{tier="bulk",provider="claude",model="claude-haiku-5-5"} 2
ghostship_ai_model_winner_position{tier="bulk",provider="antigravity",model="gemini-3.8-flash"} 3
ghostship_ai_model_rank{tier="bulk",provider="opencode-go",model="minimax_minimax-m3.1-flash_free"} 1
ghostship_ai_model_rank{tier="bulk",provider="claude",model="claude-haiku-5-5"} 2
ghostship_ai_model_rank{tier="bulk",provider="antigravity",model="gemini-3.8-flash"} 3
ghostship_ai_model_rank{tier="bulk",provider="grok",model="grok-4.6"} 4

# The promotion route: the provider publishes it as unlimited for a limited
# time, so it has no window, no pace and no measured allowance.
ghostship_ai_entitlement_info{provider="opencode-go",account="default",model="minimax_minimax-m3.1-flash_free",window="unlimited__limited-time_promotion_",quota="free-unlimited",source="published",entitlement="opencode-go:default:minimax_minimax-m3.1-flash_free:unlimited (limited-time promotion):free-unlimited",basis="promotion",ends_at=""} 1
ghostship_ai_entitlement_info{provider="opencode-go",account="default",model="minimax_minimax-m3.1-flash",window="unlimited__limited-time_promotion_",quota="free-unlimited",source="published",entitlement="opencode-go:default:minimax_minimax-m3.1-flash:unlimited (limited-time promotion):free-unlimited",basis="promotion",ends_at=""} 1

# The route ahead of the pace, the route on it, and the route behind it.
ghostship_ai_model_capacity_remaining{provider="claude",model="claude-haiku-5-5",tier="bulk"} 0.92
ghostship_ai_model_paced_availability{provider="claude",model="claude-haiku-5-5"} 0.58
ghostship_ai_model_capacity_remaining{provider="antigravity",model="gemini-3.8-flash",tier="bulk"} 0.46
ghostship_ai_model_paced_availability{provider="antigravity",model="gemini-3.8-flash"} 0
ghostship_ai_model_capacity_remaining{provider="grok",model="grok-4.6",tier="bulk"} 0
ghostship_ai_model_paced_availability{provider="grok",model="grok-4.6"} 0
ghostship_ai_model_available{provider="grok",model="grok-4.6",reason="an_allowance_of_the_account_is_spent"} 0

# The route reserved for 3D work.
ghostship_ai_model_reserved{provider="antigravity",model="gemini-3.8-flash",tier="3d",reserve="3d",withheld="ordered_last"} 1

# The value of a bulk route: its value, its AA intelligence and its cost.
ghostship_ai_model_value{provider="opencode-go",model="minimax_minimax-m3.1-flash_free",source="measured"} 0.54
ghostship_ai_model_strength{provider="opencode-go",model="minimax_minimax-m3.1-flash_free",source="measured"} 42.7
ghostship_ai_model_cost_per_task{provider="opencode-go",model="minimax_minimax-m3.1-flash_free"} 0
ghostship_ai_model_value{provider="claude",model="claude-haiku-5-5",source="measured"} 0.56
ghostship_ai_model_strength{provider="claude",model="claude-haiku-5-5",source="measured"} 41.2
ghostship_ai_model_cost_per_task{provider="claude",model="claude-haiku-5-5"} 0.8
ghostship_ai_model_value{provider="antigravity",model="gemini-3.8-flash",source="measured"} 0.43
ghostship_ai_model_strength{provider="antigravity",model="gemini-3.8-flash",source="measured"} 39.8
ghostship_ai_model_cost_per_task{provider="antigravity",model="gemini-3.8-flash"} 6.01

# The name a person would say, when the collector publishes one.
ghostship_ai_model_info{provider="opencode-go",model="minimax_minimax-m3.1-flash_free",name="MiniMax M3.1 Flash Free"} 1
ghostship_ai_model_info{provider="claude",model="claude-haiku-5-5",name="Claude Haiku 5.5"} 1
ghostship_ai_model_info{provider="antigravity",model="gemini-3.8-flash",name="Gemini 3.8 Flash"} 1
ghostship_ai_model_info{provider="grok",model="grok-4.6",name="Grok 4.6"} 1

# --- Free ------------------------------------------------------------------
# The free pool answers with one response. The band is the quality band of
# the route; it arrives with the free winners.
ghostship_ai_model_winner_position{tier="free",provider="opencode-go",model="minimax_minimax-m3.1-flash",band="true"} 1
ghostship_ai_model_winner_position{tier="free",provider="nvidia",model="glm-5.3-flash",band="true"} 2
ghostship_ai_model_winner_position{tier="free",provider="groq",model="qwen3.8-27b"} 3
ghostship_ai_model_winner_position{tier="free",provider="kilo",model="nemotron-3.5-super-vl"} 4
ghostship_ai_model_rank{tier="free",provider="opencode-go",model="minimax_minimax-m3.1-flash"} 1
ghostship_ai_model_rank{tier="free",provider="nvidia",model="glm-5.3-flash"} 2
ghostship_ai_model_rank{tier="free",provider="groq",model="qwen3.8-27b"} 3
ghostship_ai_model_rank{tier="free",provider="kilo",model="nemotron-3.5-super-vl"} 4

ghostship_ai_model_capacity_remaining{provider="nvidia",model="glm-5.3-flash",tier="free"} 0.8
ghostship_ai_model_paced_availability{provider="nvidia",model="glm-5.3-flash"} 0.12
ghostship_ai_model_capacity_remaining{provider="groq",model="qwen3.8-27b",tier="free"} 0.75
ghostship_ai_model_paced_availability{provider="groq",model="qwen3.8-27b"} 0.05
ghostship_ai_model_paced_availability{provider="kilo",model="nemotron-3.5-super-vl"} 0

# The route whose limits are unknown: the provider publishes no window.
ghostship_ai_model_quota_unknown{provider="kilo",model="nemotron-3.5-super-vl",reason="no_window"} 1

# The limit basis of every free route.
ghostship_ai_provider_limit{provider="opencode-go",model="minimax_minimax-m3.1-flash",limit="rpm",scope="account",basis="published"} -1
ghostship_ai_provider_limit{provider="nvidia",model="glm-5.3-flash",limit="rpm",scope="account",basis="configured"} 40
ghostship_ai_provider_limit{provider="groq",model="qwen3.8-27b",limit="rpd",scope="account",basis="configured"} 1000
ghostship_ai_provider_limit{provider="kilo",model="nemotron-3.5-super-vl",limit="rpm",scope="account",basis="unknown"} -1

ghostship_ai_model_strength{provider="opencode-go",model="minimax_minimax-m3.1-flash",source="measured"} 42.7
ghostship_ai_model_strength{provider="nvidia",model="glm-5.3-flash",source="measured"} 41.8
ghostship_ai_model_strength{provider="groq",model="qwen3.8-27b",source="measured"} 33.7
ghostship_ai_model_strength{provider="kilo",model="nemotron-3.5-super-vl",source="measured"} 26.5
ghostship_ai_model_info{provider="opencode-go",model="minimax_minimax-m3.1-flash",name="MiniMax M3.1 Flash"} 1
ghostship_ai_model_info{provider="nvidia",model="glm-5.3-flash",name="GLM-5.3 Flash"} 1
ghostship_ai_model_info{provider="groq",model="qwen3.8-27b",name="Qwen3.8 27B"} 1
ghostship_ai_model_info{provider="kilo",model="nemotron-3.5-super-vl",name="Nemotron 3.5 Super VL"} 1

# --- Frontier --------------------------------------------------------------
# The chief and the backup of the owner.
ghostship_ai_model_winner_position{tier="frontier",provider="claude",model="claude-opus-5-5"} 1
ghostship_ai_model_winner_position{tier="frontier",provider="codex",model="gpt-6.1-sol"} 2
ghostship_ai_model_rank{tier="frontier",provider="claude",model="claude-opus-5-5"} 1
ghostship_ai_model_rank{tier="frontier",provider="codex",model="gpt-6.1-sol"} 2
ghostship_ai_model_capacity_remaining{provider="claude",model="claude-opus-5-5",tier="frontier"} 0.92
ghostship_ai_model_paced_availability{provider="claude",model="claude-opus-5-5"} 0.58
ghostship_ai_model_capacity_remaining{provider="codex",model="gpt-6.1-sol",tier="frontier"} 0.09
ghostship_ai_model_paced_availability{provider="codex",model="gpt-6.1-sol"} -0.6
ghostship_ai_model_info{provider="claude",model="claude-opus-5-5",name="Claude Opus 5.5"} 1
ghostship_ai_model_info{provider="codex",model="gpt-6.1-sol",name="GPT-6.1-Sol"} 1

# --- 3D --------------------------------------------------------------------
# The AA-3D evidence was never written: the tier is empty.

# --- Providers -------------------------------------------------------------
# The lowest window decides. The pace of that window is the pace of the
# provider.
ghostship_ai_provider_capacity_remaining_ratio{provider="claude",binding="weekly"} 0.92
ghostship_ai_provider_paced_availability{provider="claude",binding="weekly"} 0.58
ghostship_ai_provider_capacity_remaining_ratio{provider="antigravity",binding="5_hour"} 0.46
ghostship_ai_provider_paced_availability{provider="antigravity",binding="5_hour"} 0
ghostship_ai_provider_capacity_remaining_ratio{provider="codex",binding="weekly"} 0.09
ghostship_ai_provider_paced_availability{provider="codex",binding="weekly"} -0.6
ghostship_ai_provider_capacity_remaining_ratio{provider="ollama",binding="session"} 0
ghostship_ai_provider_capacity_remaining_ratio{provider="grok",binding="prepaid_balance"} 0

# The window of every provider, and when it resets.
ghostship_ai_entitlement_info{provider="claude",account="default",model="_",window="weekly",quota="weekly",source="t3",entitlement="claude:default:_:weekly:weekly",basis="measured",ends_at=""} 1
ghostship_ai_entitlement_used_ratio{provider="claude",account="default",model="_",window="weekly",quota="weekly",source="t3",entitlement="claude:default:_:weekly:weekly",basis="measured",ends_at=""} 0.08
ghostship_ai_entitlement_reset_timestamp_seconds{provider="claude",account="default",model="_",window="weekly",quota="weekly",source="t3",entitlement="claude:default:_:weekly:weekly",basis="measured",ends_at=""} 1790600000
ghostship_ai_entitlement_info{provider="antigravity",account="default",model="_",window="5_hour",quota="5_hour",source="t3",entitlement="antigravity:default:_:5_hour:5_hour",basis="measured",ends_at=""} 1
ghostship_ai_entitlement_used_ratio{provider="antigravity",account="default",model="_",window="5_hour",quota="5_hour",source="t3",entitlement="antigravity:default:_:5_hour:5_hour",basis="measured",ends_at=""} 0.54
ghostship_ai_entitlement_reset_timestamp_seconds{provider="antigravity",account="default",model="_",window="5_hour",quota="5_hour",source="t3",entitlement="antigravity:default:_:5_hour:5_hour",basis="measured",ends_at=""} 1790007200
ghostship_ai_entitlement_info{provider="codex",account="default",model="_",window="weekly",quota="weekly",source="t3",entitlement="codex:default:_:weekly:weekly",basis="measured",ends_at=""} 1
ghostship_ai_entitlement_used_ratio{provider="codex",account="default",model="_",window="weekly",quota="weekly",source="t3",entitlement="codex:default:_:weekly:weekly",basis="measured",ends_at=""} 0.91
ghostship_ai_entitlement_reset_timestamp_seconds{provider="codex",account="default",model="_",window="weekly",quota="weekly",source="t3",entitlement="codex:default:_:weekly:weekly",basis="measured",ends_at=""} 1790600000
ghostship_ai_entitlement_info{provider="ollama",account="default",model="_",window="session",quota="session",source="t3",entitlement="ollama:default:_:session:session",basis="measured",ends_at=""} 1
ghostship_ai_entitlement_used_ratio{provider="ollama",account="default",model="_",window="session",quota="session",source="t3",entitlement="ollama:default:_:session:session",basis="measured",ends_at=""} 1
ghostship_ai_entitlement_reset_timestamp_seconds{provider="ollama",account="default",model="_",window="session",quota="session",source="t3",entitlement="ollama:default:_:session:session",basis="measured",ends_at=""} 1790003600

# The providers that publish no window at all.
ghostship_ai_provider_coverage{provider="cursor",source="t3"} 1
ghostship_ai_provider_coverage{provider="opencode",source="t3"} 1
ghostship_ai_provider_coverage{provider="claude",source="t3"} 1
ghostship_ai_provider_coverage{provider="antigravity",source="t3"} 1
ghostship_ai_provider_coverage{provider="codex",source="t3"} 1
ghostship_ai_provider_coverage{provider="ollama",source="t3"} 1
