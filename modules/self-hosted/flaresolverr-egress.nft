destroy table inet ghostship_flaresolverr
destroy table bridge ghostship_flaresolverr

table inet ghostship_flaresolverr {
    set private_ipv4 {
        type ipv4_addr; flags interval;
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
            192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
            203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 };
    }
    chain forward {
        type filter hook forward priority -10; policy accept;
        ip saddr 10.89.0.16 ct state established,related accept
        ip saddr 10.89.0.16 ip daddr @private_ipv4 drop
    }
    chain input {
        type filter hook input priority -10; policy accept;
        ip saddr 10.89.0.16 ct state established,related accept
        # Podman's DNS resolver is the sole permitted new host connection.
        ip saddr 10.89.0.16 ip daddr 10.89.0.1 udp dport 53 accept
        ip saddr 10.89.0.16 ip daddr 10.89.0.1 tcp dport 53 accept
        ip saddr 10.89.0.16 drop
    }
}

table bridge ghostship_flaresolverr {
    set private_ipv4 {
        type ipv4_addr; flags interval;
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
            192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
            203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 };
    }
    chain prerouting {
        type filter hook prerouting priority -300; policy accept;
        # This network is IPv4-only; deny link-local IPv6 as well.
        ether saddr 02:89:00:00:00:16 ether type ip6 drop
    }
    chain forward {
        type filter hook forward priority -10; policy accept;
        ip saddr 10.89.0.16 ct state established,related accept
        ip saddr 10.89.0.16 ip daddr @private_ipv4 drop
    }
}
