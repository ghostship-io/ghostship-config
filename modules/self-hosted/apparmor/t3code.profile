# Development executes repository code by design. Keep that permission scoped
# to the Nix store and development state, and learn missing runtime permissions.
profile ghostship-t3code flags=(attach_disconnected,mediate_deleted) {
  signal (receive) peer=unconfined,
  signal (send,receive) peer=ghostship-t3code,
  ptrace (read,trace) peer=ghostship-t3code,
  userns,
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,
  network unix dgram,
  network netlink raw,
  capability chown,
  capability dac_override,
  capability fowner,
  capability fsetid,
  capability kill,
  capability setgid,
  capability setuid,
  capability setpcap,
  capability setfcap,
  capability sys_chroot,
  capability sys_resource,
  / r,
  /{bin,lib,lib64,usr}/** rix,
  /nix/** rwklmix,
  /etc/** r,
  /etc/{passwd,group,machine-id,hostname,hosts,resolv.conf} rw,
  /etc/systemd/** rwkl,
  /home/t3code/** rwklmix,
  /workspace/** rwklmix,
  /tmp/** rwklmix,
  /var/tmp/** rwklmix,
  /var/{log,lib/systemd}/** rwkl,
  /run/** rwklmix,
  /proc/ r,
  /proc/** r,
  /proc/[0-9]*/{oom_score_adj,comm,attr/exec} w,
  /sys/fs/cgroup/** rw,
  /sys/devices/** r,
  /sys/kernel/{uevent_seqnum,osrelease} r,
  /dev/{null,zero,random,urandom,tty,ptmx} rw,
  /dev/pts/** rw,
  /dev/shm/** rwklm,
  mount fstype=tmpfs -> /{run,tmp,dev}/**,
  mount options=(rw,bind) /** -> /{run,tmp,nix}/**,
  mount options=(ro,remount,bind) -> /{run,tmp,nix}/**,
  umount /{run,tmp,nix}/**,
  deny /proc/sys/** w,
  deny /proc/{sysrq-trigger,kcore} rwklx,
  deny /sys/kernel/security/** rwklx,
  deny /sys/firmware/** rwklx,
  deny /dev/{mem,kmem,kmsg,sd*,nvme*,mapper{,/**}} rwklx,
}
