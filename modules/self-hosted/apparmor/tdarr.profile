# Container policy, inspected on chill-penguin (aarch64), 2026-10-20:
# ghcr.io/haveagitgat/tdarr@sha256:a7cf8ad422a5 (Ubuntu 24.04, LinuxServer-style
# s6-overlay 3.2.1.0). Startup runs as root; Tdarr runs as abc, uid/gid 3000.
# Process tree: s6 -> Tdarr_Server -> Tdarr_Server_Rust (API/DB on 8265/8266);
# s6 -> Tdarr_Node -> Tdarr_Node_Rust -> Tdarr_Node_Runtime (bundled Node.js
# running plugin-runner/run-plugin.js per worker) -> ffmpeg (nix store, from
# ffmpegPath). Scans use the bundled assets ffprobe, exiftool-vendored (Perl)
# and mediainfo.js (WASM, no exec). HandBrake, mkvpropedit, ccextractor, pnpm,
# apprise and the Docker auto-updater are not configured and get no exec.
# No explicit deny: those rules would enforce even while in complain mode.
# No abstractions: their implicit permissions would obscure this allowlist.

@{td_libdir} = /usr/lib/aarch64-linux-gnu
@{td_s6} = /package/admin/s6-overlay-3.2.1.0
@{td_bundled_ffmpeg} = /app/Tdarr_{Node,Server}/assets/app/ffmpeg/linux_arm64
@{td_exiftool} = /app/Tdarr_{Node,Server}/node_modules/exiftool-vendored.pl

profile ghostship-tdarr flags=(complain,attach_disconnected,mediate_deleted) {
  # ---- Startup: s6-overlay, LinuxServer oneshots, cont-init.d, services.d ----
  /init rix,
  /usr/bin/{bash,dash,with-contenv,lsiown} rix,
  /usr/bin/{cat,chmod,chown,cp,crontab,cut,date,dirname,basename,find,getent,grep,head,id,ln,ls,mawk,mkdir,mv,printf,rm,sed,sleep,sort,stat,tail,tr,uname,wc} rix,
  /usr/sbin/{groupmod,usermod,cron} rix,
  /package/admin/execline-2.9.7.0/command/execline rix,
  /package/admin/s6-portable-utils-2.3.1.0/command/s6-portable-utils rix,
  /package/admin/s6-linux-utils-2.6.3.0/command/s6-linux-utils rix,
  /package/admin/s6-overlay-helpers-0.1.2.0/command/{s6-overlay-stat,s6-overlay-suexec} rix,
  /package/admin/s6-2.13.2.0/command/{s6-svscan,s6-supervise,s6-svscanctl,s6-svc,s6-svwait,s6-svlisten1,s6-ftrigrd,s6-ftrig-notify,s6-envdir,s6-setuidgid,s6-envuidgid,s6-applyuidgid,s6-notifyoncheck,s6-ipcserver-socketbinder,s6-ipcserverd,s6-ipcserver-access,s6-ipcclient,s6-sudoc,s6-sudod,s6-fdholderd,s6-fdholder-daemon,s6-fdholder-store,s6-fdholder-retrieve,s6-fdholder-delete,s6-setsid,s6-log,s6-tai64n} rix,
  /package/admin/s6-rc-0.5.6.0/command/{s6-rc,s6-rc-init,s6-rc-compile,s6-rc-db,s6-rc-oneshot-run,s6-rc-fdholder-filler} rix,
  /package/admin/s6-linux-init-1.1.3.0/command/{s6-linux-init,s6-linux-init-maker,s6-linux-init-shutdownd,s6-linux-init-hpr,s6-linux-init-nuke,s6-linux-init-umountall} rix,
  @{td_s6}/command/{with-contenv,printcontenv,logutil-service,logutil-newfifo} rix,
  @{td_s6}/libexec/{preinit,stage0,fix-attrs,logutil-service-main} rix,
  @{td_s6}/etc/** r,
  @{td_s6}/etc/s6-rc/scripts/{cont-init,cont-finish,fix-attrs,services-up,services-down} rix,
  @{td_s6}/etc/s6-linux-init/skel/{rc.init,rc.shutdown,rc.shutdown.final} rix,
  /etc/s6-overlay/s6-rc.d/** r,
  /etc/s6-overlay/s6-rc.d/{init-adduser,init-crontab-config,init-custom-files,init-device-perms,init-envfile,init-migrations,init-mods-package-install,svc-cron}/run rix,
  /etc/cont-init.d/ r,
  /etc/cont-init.d/{01-setup-perms,02-hw-transcoding,03-setup-ffmpeg} rix,
  /etc/services.d/ r,
  /etc/services.d/** r,

  # s6-generated runtime scripts: an intentional, limited code-loading risk.
  # Never extend this to /run/**, /tmp/**, /temp/** or /app/**.
  /run/s6/basedir/bin/{init,halt,poweroff,reboot} rix,
  /run/s6/basedir/scripts/{rc.init,rc.shutdown,rc.shutdown.final} rix,
  /run/{service,s6/basedir/run-image/service}/.s6-svscan/{SIGINT,SIGPWR,SIGQUIT,SIGTERM,SIGUSR1,SIGUSR2,SIGWINCH,crash,finish} rix,
  /run/{service,s6/basedir/run-image/service}/s6-linux-init-shutdownd/run rix,
  /run/s6/db/servicedirs/{s6rc-fdholder,s6rc-oneshot-runner,svc-cron}/run rix,
  /run/s6-rc:s6-rc-init:*/servicedirs/{s6rc-fdholder,s6rc-oneshot-runner,svc-cron}/run rix,
  /run/s6/legacy-services/{tdarr_node,tdarr_server,update_monitor}/run rix,

  @{td_libdir}/ld-linux-aarch64.so.1 mr,
  @{td_libdir}/lib{c.so.6,m.so.6,dl.so.2,pthread.so.0,rt.so.1,gcc_s.so.1,tinfo.so.6.4,pcre2-8.so.0.11.2,selinux.so.1,acl.so.1.1.2302,attr.so.1.1.2502,audit.so.1.0.0,cap-ng.so.0.0.0,pam.so.0.85.1,semanage.so.2,sepol.so.2,bz2.so.1.0.4,crypto.so.3} mr,
  @{td_libdir}/security/*.so mr,
  @{td_libdir}/gconv/gconv-modules.cache r,

  /run/s6/ rw,
  /run/s6/** rwk,
  /run/service/ rw,
  /run/service/** rwk,
  /run/s6-rc:s6-rc-init:*/ rw,
  /run/s6-rc:s6-rc-init:*/** rwk,
  /run/s6-linux-init-container-results/ rw,
  /run/s6-linux-init-container-results/** rw,
  /var/run/s6/{,services/,legacy-services/} r,

  # init-adduser/01-setup-perms: groupmod/usermod rewrite the account files.
  /etc/{passwd,group,shadow,gshadow,subuid,subgid}{,-,+} rw,
  /etc/{passwd,group,shadow,gshadow}.{[0-9]*,lock} rwl,
  /etc/.pwd.lock rwk,
  /etc/login.defs r,
  /etc/default/useradd r,
  /etc/pam.d/** r,
  /etc/security/** r,
  /var/log/{faillog,lastlog} rw,
  # lsiown (depth 0) and 01-setup-perms chown passes. These cover the whole
  # /app tree except /app/server and node_modules, /home/Tdarr, /logs and
  # /temp: the image re-owns its own executables to abc on every start.
  /app/ rw,
  /app/** r,
  /app/Tdarr_{Node,Server}/{,**} w,
  /app/{configs,logs}/{,**} w,
  /app/server/ rw,
  /app/server/perm/ rw,
  /app/server/perm/{puid,pgid} rw,
  /home/Tdarr/{,**} rw,
  /logs/{,**} rw,
  /temp/ rw,
  /temp/** rw,
  /config/ rw,
  /defaults/ rw,
  # svc-cron/init-crontab-config probe empty crontabs only.
  /var/spool/cron/crontabs/{,abc,root} r,
  /etc/crontabs/{,abc,root} r,
  /defaults/crontabs/{,abc,root} r,
  # update_monitor: disabled (sleep infinity), but its failure dir path.
  /tmp/ r,
  /tmp/tdarr_s6_failed/ rw,
  /custom-cont-init.d/ r,
  /migrations/ r,
  /config/.migrations r,
  /mod-{repo,pip}-packages-to-install.list r,
  /etc/os-release r,

  / r,
  /{etc,usr,usr/lib,usr/share,run,dev,proc,sys}/ r,
  /etc/{nsswitch.conf,hosts,hostname,resolv.conf,host.conf,gai.conf,ld.so.cache,localtime,timezone,environment,services,protocols} r,
  /{build_version,donate.txt} r,
  /usr/lib/locale/** r,
  /usr/share/zoneinfo/** r,
  /dev/null rw,
  /dev/{random,urandom} r,
  /dev/{stdin,stdout,stderr} rw,
  /dev/fd/[0-9]* rw,
  /proc/sys/kernel/{hostname,osrelease,ostype,ngroups_max} r,
  /proc/{self,thread-self}/fd/ r,
  /proc/{self,thread-self}/fd/[0-9]* rw,
  /proc/{self,thread-self}/{stat,status,loginuid} r,
  # The AppArmor review's heartbeat `podman exec tdarr /bin/cat`.
  audit /proc/sys/kernel/random/boot_id r,

  # LinuxServer startup and s6-setuidgid; no network admin or raw sockets.
  capability chown,
  capability dac_override,
  capability dac_read_search,
  capability fowner,
  capability fsetid,
  capability setuid,
  capability setgid,
  capability kill,
  capability audit_write,
  # s6 supervision and s6-rc oneshot sockets under /run.
  unix (create, bind, listen, accept, connect, send, receive, getattr, getopt, setopt, shutdown) type=stream,

  # ---- Transitions ----
  /app/Tdarr_Server/Tdarr_Server cx -> server,
  /app/Tdarr_Node/Tdarr_Node cx -> node,
  # 03-setup-ffmpeg's `ffmpeg -version` through /usr/local/bin.
  /usr/lib/jellyfin-ffmpeg/{ffmpeg,ffprobe} cx -> transcode,
  # Podman healthcheck (`sh -c curl`) and the host's tdarr-bootstrap /
  # tdarr-staged-guard `podman exec tdarr curl` calls to 127.0.0.1:8265.
  /usr/bin/curl cx -> healthcheck,

  signal (receive) peer=unconfined,
  signal (send, receive) peer=ghostship-tdarr,
  signal (send) peer=ghostship-tdarr//{server,node,scanner,worker,transcode,exiftool,healthcheck},

  # Tdarr_Server launcher and Tdarr_Server_Rust: web UI/API, DB, scheduling.
  profile server flags=(complain,attach_disconnected,mediate_deleted) {
    /app/Tdarr_Server/Tdarr_Server rm,
    /app/Tdarr_Server/rust/Tdarr_Server_Rust rix,
    /app/Tdarr_Server/runtime/Tdarr_Server_Runtime px -> ghostship-tdarr//scanner,
    @{td_bundled_ffmpeg}/{ffmpeg,ffprobe} px -> ghostship-tdarr//transcode,
    /nix/store/*-ffmpeg-headless-9.0.1-bin/bin/{ffmpeg,ffprobe} px -> ghostship-tdarr//transcode,
    @{td_exiftool}/bin/exiftool px -> ghostship-tdarr//exiftool,
    /usr/bin/perl px -> ghostship-tdarr//exiftool,
    @{td_libdir}/ld-linux-aarch64.so.1 mr,
    @{td_libdir}/lib{c.so.6,m.so.6,gcc_s.so.1} mr,

    /app/Tdarr_Server/ r,
    /app/Tdarr_Server/** r,
    /app/server/ r,
    /app/server/** rwk,
    /app/configs/ r,
    /app/configs/{Tdarr_Server_Config.json,Last_Run_Tdarr_Server.txt,Tdarr_Rollout_ID}{,.*} rw,
    /app/logs/ r,
    /app/logs/Tdarr_Server_Log.txt* rw,
    # Library scans and cache cleanup only; media replacement is the worker's.
    /source/ r,
    /source/{Movies,TV}/{,**} r,
    /media/{,**} r,
    /temp/ r,
    /temp/** rw,

    /etc/{passwd,group,nsswitch.conf,hosts,resolv.conf,host.conf,gai.conf,ld.so.cache,localtime,os-release,ssl/openssl.cnf} r,
    /etc/ssl/certs/** r,
    /usr/share/zoneinfo/** r,
    /dev/null rw,
    /dev/urandom r,
    /proc/{self,thread-self}/** r,
    /proc/[0-9]*/{stat,status,cmdline} r,
    /proc/{stat,meminfo,cpuinfo,loadavg,uptime,mounts} r,
    /sys/devices/system/cpu/** r,
    /sys/fs/cgroup/{,**} r,

    network inet stream,
    network inet6 stream,
    network inet dgram,
    network inet6 dgram,
    signal (receive) peer=unconfined,
    signal (receive) peer=ghostship-tdarr,
    signal (send, receive) peer=ghostship-tdarr//server,
    signal (send) peer=ghostship-tdarr//{scanner,transcode,exiftool},
  }

  # Tdarr_Node launcher and Tdarr_Node_Rust: worker scheduling, plugin sync.
  profile node flags=(complain,attach_disconnected,mediate_deleted) {
    /app/Tdarr_Node/Tdarr_Node rm,
    /app/Tdarr_Node/rust/Tdarr_Node_Rust rix,
    /app/Tdarr_Node/runtime/Tdarr_Node_Runtime px -> ghostship-tdarr//worker,
    @{td_bundled_ffmpeg}/{ffmpeg,ffprobe} px -> ghostship-tdarr//transcode,
    /nix/store/*-ffmpeg-headless-9.0.1-bin/bin/{ffmpeg,ffprobe} px -> ghostship-tdarr//transcode,
    @{td_exiftool}/bin/exiftool px -> ghostship-tdarr//exiftool,
    /usr/bin/perl px -> ghostship-tdarr//exiftool,
    @{td_libdir}/ld-linux-aarch64.so.1 mr,
    @{td_libdir}/lib{c.so.6,m.so.6,gcc_s.so.1,ssl.so.3,crypto.so.3} mr,

    /app/Tdarr_Node/ r,
    /app/Tdarr_Node/** r,
    # Plugins synced from the server and later require()d by the worker:
    # a writable code path, see the review notes.
    /app/Tdarr_Node/assets/app/plugins/ rw,
    /app/Tdarr_Node/assets/app/plugins/** rwk,
    /app/configs/ r,
    /app/configs/{Tdarr_Node_Config.json,Last_Run_Tdarr_Node.txt}{,.*} rw,
    /app/logs/ r,
    /app/logs/Tdarr_Node_Log.txt* rw,
    /source/ r,
    /source/{Movies,TV}/{,**} r,
    /media/{,**} r,
    /temp/ r,
    /temp/** rw,

    /etc/{passwd,group,nsswitch.conf,hosts,resolv.conf,host.conf,gai.conf,ld.so.cache,localtime,os-release,ssl/openssl.cnf} r,
    /etc/ssl/certs/** r,
    /dev/null rw,
    /dev/urandom r,
    /dev/dri/ r,
    /proc/{self,thread-self}/** r,
    /proc/[0-9]*/{stat,status,cmdline} r,
    /proc/{stat,meminfo,cpuinfo,loadavg,uptime,mounts} r,
    /sys/devices/system/cpu/** r,
    /sys/fs/cgroup/{,**} r,

    network inet stream,
    network inet6 stream,
    network inet dgram,
    network inet6 dgram,
    signal (receive) peer=unconfined,
    signal (receive) peer=ghostship-tdarr,
    signal (send, receive) peer=ghostship-tdarr//node,
    signal (send) peer=ghostship-tdarr//{worker,transcode,exiftool},
  }

  # Server-side bundled Node.js runtime: scanner-tool-runner (exiftool,
  # mediainfo.js) and server-side helpers. Read-only on media and state.
  profile scanner flags=(complain,attach_disconnected,mediate_deleted) {
    /app/Tdarr_Server/runtime/Tdarr_Server_Runtime rm,
    @{td_bundled_ffmpeg}/ffprobe px -> ghostship-tdarr//transcode,
    /nix/store/*-ffmpeg-headless-9.0.1-bin/bin/ffprobe px -> ghostship-tdarr//transcode,
    @{td_exiftool}/bin/exiftool px -> ghostship-tdarr//exiftool,
    /usr/bin/perl px -> ghostship-tdarr//exiftool,
    @{td_libdir}/ld-linux-aarch64.so.1 mr,
    @{td_libdir}/lib{c.so.6,m.so.6,dl.so.2,pthread.so.0,gcc_s.so.1,stdc++.so.6.0.33} mr,
    /app/Tdarr_Server/ r,
    /app/Tdarr_Server/{srcug,node_modules}/** r,
    /app/Tdarr_Server/node_modules/**.node mr,
    /app/server/Tdarr/ r,
    /app/server/Tdarr/** r,
    /source/ r,
    /source/{Movies,TV}/{,**} r,
    /media/{,**} r,
    /temp/{,**} r,
    /etc/{passwd,group,nsswitch.conf,hosts,resolv.conf,ld.so.cache,localtime,ssl/openssl.cnf} r,
    /dev/null rw,
    /dev/urandom r,
    /proc/{self,thread-self}/** r,
    /proc/{stat,meminfo,cpuinfo} r,
    /sys/devices/system/cpu/** r,
    /sys/fs/cgroup/{,**} r,
    network inet stream,
    network inet6 stream,
    signal (receive) peer=unconfined,
    signal (receive) peer=ghostship-tdarr{,//server},
    signal (send, receive) peer=ghostship-tdarr//scanner,
    signal (send) peer=ghostship-tdarr//{transcode,exiftool},
  }

  # Node-side bundled Node.js runtime running flows: the ghostship Local flow
  # plugins (policy read, validation, atomic Plex replacement) and community
  # plugins. The only domain that may write the media libraries.
  profile worker flags=(complain,attach_disconnected,mediate_deleted) {
    /app/Tdarr_Node/runtime/Tdarr_Node_Runtime rm,
    @{td_bundled_ffmpeg}/{ffmpeg,ffprobe} px -> ghostship-tdarr//transcode,
    /nix/store/*-ffmpeg-headless-9.0.1-bin/bin/{ffmpeg,ffprobe} px -> ghostship-tdarr//transcode,
    @{td_exiftool}/bin/exiftool px -> ghostship-tdarr//exiftool,
    /usr/bin/perl px -> ghostship-tdarr//exiftool,
    @{td_libdir}/ld-linux-aarch64.so.1 mr,
    @{td_libdir}/lib{c.so.6,m.so.6,dl.so.2,pthread.so.0,gcc_s.so.1,stdc++.so.6.0.33} mr,
    /app/Tdarr_Node/ r,
    /app/Tdarr_Node/{srcug,node_modules}/** r,
    /app/Tdarr_Node/node_modules/**.node mr,
    /app/Tdarr_Node/assets/app/plugins/ r,
    /app/Tdarr_Node/assets/app/plugins/** r,
    /app/configs/{,Tdarr_Node_Config.json} r,
    /policy/ r,
    /policy/original-languages.json r,
    /source/ r,
    /source/{Movies,TV}/ r,
    /source/{Movies,TV}/** rwk,
    /media/ r,
    /media/** rwk,
    /temp/ r,
    /temp/** rwk,
    /etc/{passwd,group,nsswitch.conf,hosts,resolv.conf,ld.so.cache,localtime,ssl/openssl.cnf} r,
    /dev/null rw,
    /dev/urandom r,
    /proc/{self,thread-self}/** r,
    /proc/{stat,meminfo,cpuinfo,loadavg} r,
    /sys/devices/system/cpu/** r,
    /sys/fs/cgroup/{,**} r,
    network inet stream,
    network inet6 stream,
    signal (receive) peer=unconfined,
    signal (receive) peer=ghostship-tdarr{,//node},
    signal (send, receive) peer=ghostship-tdarr//worker,
    signal (send) peer=ghostship-tdarr//{transcode,exiftool},
  }

  # ffmpeg/ffprobe: read the library, write only the transcode cache.
  profile transcode flags=(complain,attach_disconnected,mediate_deleted) {
    /nix/store/*-ffmpeg-headless-9.0.1-bin/bin/{ffmpeg,ffprobe} rm,
    @{td_bundled_ffmpeg}/{ffmpeg,ffprobe} rm,
    /usr/lib/jellyfin-ffmpeg/{ffmpeg,ffprobe} rm,

    # Nix ffmpeg-headless 9.0.1 closure (the configured ffmpegPath). Only the
    # store hash is globbed; a nixpkgs bump changes these versions and
    # requires review, like any image library change.
    /nix/store/*-alsa-lib-1.2.16.1/lib/libasound.so.2.0.0 mr,
    /nix/store/*-brotli-1.2.0-lib/lib/{libbrotlicommon.so.1.2.0,libbrotlidec.so.1.2.0} mr,
    /nix/store/*-bzip2-1.0.8/lib/libbz2.so.1.0.8 mr,
    /nix/store/*-cjson-1.7.19/lib/libcjson.so.1.7.19 mr,
    /nix/store/*-dav1d-1.5.3/lib/libdav1d.so.7.0.0 mr,
    /nix/store/*-expat-2.8.3/lib/libexpat.so.1.12.3 mr,
    /nix/store/*-ffmpeg-headless-9.0.1-lib/lib/{libavcodec.so.63.1.101,libavdevice.so.63.1.101,libavfilter.so.12.1.101,libavformat.so.63.1.101,libavutil.so.61.1.101,libswresample.so.7.1.101,libswscale.so.10.1.101} mr,
    /nix/store/*-fontconfig-2.18.2-lib/lib/libfontconfig.so.1.16.1 mr,
    /nix/store/*-freetype-2.14.3/lib/libfreetype.so.6.20.6 mr,
    /nix/store/*-fribidi-1.0.16/lib/libfribidi.so.0.4.0 mr,
    /nix/store/*-gcc-15.3.0-lib/lib/{libatomic.so.1.2.0,libgomp.so.1.0.0,libstdc++.so.6.0.34} mr,
    /nix/store/*-gcc-15.3.0-libgcc/lib/libgcc_s.so.1 mr,
    /nix/store/*-glib-2.88.3/lib/libglib-2.0.so.0.8800.3 mr,
    /nix/store/*-glibc-2.42-84/lib/{ld-linux-aarch64.so.1,libc.so.6,libdl.so.2,libm.so.6,libmvec.so.1,libpthread.so.0,librt.so.1} mr,
    /nix/store/*-gmp-with-cxx-6.3.0/lib/libgmp.so.10.5.0 mr,
    /nix/store/*-gnutls-3.8.13/lib/libgnutls.so.30.42.0 mr,
    /nix/store/*-graphite2-1.3.15/lib/libgraphite2.so.3.3.1 mr,
    /nix/store/*-harfbuzz-13.2.1/lib/libharfbuzz.so.0.61321.0 mr,
    /nix/store/*-lame-3.100-lib/lib/libmp3lame.so.0.0.0 mr,
    /nix/store/*-libaom-3.12.1/lib/libaom.so.3.12.1 mr,
    /nix/store/*-libass-0.17.4/lib/libass.so.9.4.1 mr,
    /nix/store/*-libbluray-1.4.1/lib/libbluray.so.3.1.0 mr,
    /nix/store/*-libdrm-2.4.134/lib/libdrm.so.2.134.0 mr,
    /nix/store/*-libffi-3.8.0/lib/libffi.so.8.5.0 mr,
    /nix/store/*-libidn2-2.3.8/lib/libidn2.so.0.4.0 mr,
    /nix/store/*-libjpeg-turbo-3.1.4.1/lib/libjpeg.so.62.4.0 mr,
    /nix/store/*-libogg-1.3.6/lib/libogg.so.0.8.6 mr,
    /nix/store/*-libopenmpt-0.8.7/lib/libopenmpt.so.0.5.5 mr,
    /nix/store/*-libopus-1.6.1/lib/libopus.so.0.11.1 mr,
    /nix/store/*-libpng-apng-1.6.58/lib/libpng16.so.16.58.0 mr,
    /nix/store/*-librist-0.2.11/lib/librist.so.4.4.0 mr,
    /nix/store/*-libssh-0.12.2/lib/libssh.so.4.12.0 mr,
    /nix/store/*-libtasn1-4.21.0/lib/libtasn1.so.6.6.5 mr,
    /nix/store/*-libtheora-1.2.0/lib/{libtheoradec.so.2.1.1,libtheoraenc.so.2.2.1} mr,
    /nix/store/*-libunistring-1.4.2/lib/libunistring.so.5.2.1 mr,
