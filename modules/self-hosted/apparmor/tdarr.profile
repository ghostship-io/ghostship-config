    # Bundled static-ish ffmpeg/ffprobe (glibc only) and Jellyfin ffmpeg 7.
    @{td_libdir}/ld-linux-aarch64.so.1 mr,
    @{td_libdir}/lib{c.so.6,m.so.6,dl.so.2,pthread.so.0} mr,
    /usr/lib/jellyfin-ffmpeg/lib/{libSvtAv1Enc.so.3.1.2,libass.so.9.4.1,libavcodec.so.61,libavdevice.so.61,libavfilter.so.10,libavformat.so.61,libavutil.so.59,libchromaprint.so.1.6.0,libdav1d.so.7.0.0,libfdk-aac.so.2.0.2,libfftw3f.so.3.6.10,libfontconfig.so.1.16.1,libfreetype.so.6.20.4,libfribidi.so.0.4.0,libharfbuzz.so.0.61040.0,libiconv.so.2.7.0,libpostproc.so.58,librga.so.2.1.0,librockchip_mpp.so.0,libswresample.so.5,libswscale.so.8,libunibreak.so.7.0.0,libxml2.so.16.1.1,libz.so.1.3.1,libzimg.so.2.0.0} mr,
    @{td_libdir}/lib{OpenCL.so.1.0.0,X11.so.6.4.0,Xau.so.6.0.0,Xdmcp.so.6.0.0,Xext.so.6.4.0,Xrender.so.1.3.0,bluray.so.2.4.3,brotlicommon.so.1.1.0,brotlidec.so.1.1.0,bsd.so.0.12.1,bz2.so.1.0.4,cairo.so.2.11800.0,drm.so.2.125.0,expat.so.1.9.1,ffi.so.8.1.4,fontconfig.so.1.12.1,freetype.so.6.20.1,gcc_s.so.1,gmp.so.10.5.0,gnutls.so.30.37.1,hogweed.so.6.8,icudata.so.74.2,icuuc.so.74.2,idn2.so.0.4.0,lzma.so.5.4.5,md.so.0.1.0,mp3lame.so.0.0.0,mpg123.so.0.48.2,nettle.so.8.8,numa.so.1.0.0,ogg.so.0.8.5,openmpt.so.0.4.4,opus.so.0.9.0,p11-kit.so.0.3.1,pixman-1.so.0.42.2,png16.so.16.43.0,sharpyuv.so.0.0.1,stdc++.so.6.0.33,tasn1.so.6.6.3,theoradec.so.1.1.4,theoraenc.so.1.1.2,udfread.so.0.1.0,unistring.so.5.0.0,vorbis.so.0.4.9,vorbisenc.so.2.0.12,vorbisfile.so.3.3.8,vpx.so.9.0.0,webp.so.7.1.8,webpmux.so.3.0.13,x264.so.164,x265.so.199,xcb-render.so.0.0.0,xcb-shm.so.0.0.0,xcb.so.1.1.0,xml2.so.2.9.14,z.so.1.3,zvbi.so.0.13.2} mr,

    /etc/{ld.so.cache,localtime} r,
    /source/ r,
    /source/{Movies,TV}/{,**} r,
    /media/{,**} r,
    /temp/ r,
    /temp/** rwk,
    /dev/null rw,
    /dev/urandom r,
    /proc/{self,thread-self}/{stat,status,maps,cgroup,mountinfo} r,
    /proc/{cpuinfo,meminfo,stat} r,
    /sys/devices/system/cpu/** r,
    /sys/devices/system/node/** r,
    /sys/fs/cgroup/{,**} r,
    signal (receive) peer=unconfined,
    signal (receive) peer=ghostship-tdarr{,//server,//node,//scanner,//worker},
    signal (send, receive) peer=ghostship-tdarr//transcode,
  }

  # exiftool-vendored: the Perl exiftool script in -stay_open mode.
  profile exiftool flags=(complain,attach_disconnected,mediate_deleted) {
    @{td_exiftool}/bin/exiftool r,
    /usr/bin/perl rix,
    @{td_libdir}/ld-linux-aarch64.so.1 mr,
    @{td_libdir}/lib{c.so.6,m.so.6,crypt.so.1.1.0} mr,
    @{td_exiftool}/bin/ r,
    @{td_exiftool}/bin/** r,
    @{td_libdir}/perl{,-base}/ r,
    @{td_libdir}/perl{,-base}/** r,
    @{td_libdir}/perl{,-base}/**.so mr,
    /usr/share/perl{,5}/ r,
    /usr/share/perl{,5}/** r,
    /etc/{ld.so.cache,localtime,passwd} r,
    /source/ r,
    /source/{Movies,TV}/{,**} r,
    /media/{,**} r,
    /temp/{,**} r,
    /dev/null rw,
    /proc/{self,thread-self}/{fd/,stat,status} r,
    signal (receive) peer=unconfined,
    signal (receive) peer=ghostship-tdarr{,//server,//node,//scanner,//worker},
    signal (send, receive) peer=ghostship-tdarr//exiftool,
  }

  # Probes of http://127.0.0.1:8265 only.
  profile healthcheck flags=(complain,attach_disconnected,mediate_deleted) {
    /usr/bin/curl rm,
    @{td_libdir}/ld-linux-aarch64.so.1 mr,
    @{td_libdir}/lib{c.so.6,resolv.so.2,curl.so.4.8.0,brotlicommon.so.1.1.0,brotlidec.so.1.1.0,com_err.so.2.1,crypto.so.3,ssl.so.3,ffi.so.8.1.4,gmp.so.10.5.0,gnutls.so.30.37.1,gssapi_krb5.so.2.2,hogweed.so.6.8,idn2.so.0.4.0,k5crypto.so.3.1,keyutils.so.1.10,krb5.so.3.3,krb5support.so.0.1,lber.so.2.0.200,ldap.so.2.0.200,nettle.so.8.8,nghttp2.so.14.26.0,p11-kit.so.0.3.1,psl.so.5.3.4,rtmp.so.1,sasl2.so.2.0.25,ssh.so.4.9.6,tasn1.so.6.6.3,unistring.so.5.0.0,z.so.1.3,zstd.so.1.5.5} mr,
    /etc/{ld.so.cache,nsswitch.conf,passwd,hosts,resolv.conf,host.conf,gai.conf,ssl/openssl.cnf,gnutls/config} r,
    /usr/lib/locale/** r,
    / r,
    /dev/null rw,
    # tdarr-bootstrap posts these mounted request files with --data-binary @file.
    /bootstrap/ r,
    /bootstrap/*.json r,
    network inet stream,
    network inet6 stream,
    signal (receive) peer=unconfined,
    signal (receive) peer=ghostship-tdarr,
    signal (send, receive) peer=ghostship-tdarr//healthcheck,
  }
}
