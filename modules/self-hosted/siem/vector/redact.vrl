# Last step before storage: remove secrets from every string field, at any
# depth (message, request path, Falco command lines and output fields, audit
# names and process titles, and any field a future source adds).
# Query parameters, bearer and basic credentials, auth headers and cookies,
# JWTs, URL credentials, password command-line arguments and private keys.
. = map_values(., recursive: true) -> |value| {
  if is_string(value) {
    text = string!(value)
    text = replace(text, r'(?s)-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----', "[REDACTED-PRIVATE-KEY]")
    text = replace(text, r'(?i)(?P<k>(?:x-plex-token|token|api[_-]?key|apikey|access[_-]?token|refresh[_-]?token|client[_-]?secret|auth|password|passwd|pwd|secret|session|signature|sig)=)[^&\s"]+', "$k[REDACTED]")
    text = replace(text, r'(?i)(?P<k>\b(?:bearer|basic)\s+)[A-Za-z0-9._~+/=-]+', "$k[REDACTED]")
    text = replace(text, r'(?i)(?P<k>\b(?:proxy-)?authorization\s*[:=]\s*)(?P<s>(?:bearer|basic|token)\s+)?[^\s&"]+', "$k$s[REDACTED]")
    text = replace(text, r'(?i)(?P<k>\b(?:cookie|set-cookie|x-api-key|x-plex-token|cf-access-token|cf-access-jwt-assertion)\s*:\s*)[^\s";]+(?:;\s*[^\s";]+)*', "$k[REDACTED]")
    text = replace(text, r'\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b', "[REDACTED-JWT]")
    text = replace(text, r'(?P<k>://[^/\s:@]+:)[^@\s/]+@', "$k[REDACTED]@")
    text = replace(text, r'(?i)(?P<k>--(?:password|passwd|pass|token|secret|api-key|apikey)(?:=|\s+))\S+', "$k[REDACTED]")
    # MySQL/MariaDB clients take the password glued to -p (romm-db's poststart
    # did). Only for those tools: a generic -p rule would hide `find -perm`.
    text = replace(text, r'(?i)(?P<k>\b(?:mysql|mariadb|mysqldump|mariadb-dump|mysqladmin|mariadb-admin|mariadb-upgrade|mysql_upgrade)\b[^\n]*?\s-p)[^\s-]\S*', "$k[REDACTED]")
    text
  } else {
    value
  }
}
