 "panels": [
  {
   "id": 1000,
   "title": "",
   "type": "text",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 2
   },
   "options": {
    "mode": "markdown",
    "content": "**Pipeline \u00b7 is evidence still arriving?**\n\nTiles are latest snapshot (watchdog-gated where noted). Trends follow the time picker."
   }
  },
  {
   "id": 8,
   "title": "Firing alerts",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "(count(ALERTS{alertstate=\"firing\"}) or vector(0)) and on() (time() - ghostship_siem_watchdog_last_run_timestamp_seconds < 180) and on() (time() - timestamp(node_uname_info) < 180) and on() (count(node_systemd_unit_state{name=~\"podman-vmalert-(logs|metrics)\\\\.service\",state=\"active\"} == 1) == 2)",
     "legendFormat": "firing",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "Unavailable",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#fab219",
        "value": 1
       },
       {
        "color": "#d03b3b",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "justifyMode": "center",
    "wideLayout": true
   },
   "description": "Latest snapshot, gated on a fresh watchdog. Unavailable when the gate fails, never a fake 0 from outside the gate."
  },
