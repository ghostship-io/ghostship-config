  {
   "id": 16,
   "title": "Firing alerts by name",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 24,
    "h": 8,
    "x": 0,
    "y": 28
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "ALERTS{alertstate=\"firing\"}",
     "legendFormat": "{{alertname}}",
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "Unknown"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "alertstate": true
      },
      "renameByName": {
       "alertname": "Alert",
       "severity": "Severity",
       "container": "Container"
      }
     }
    }
   ],
   "description": "Currently firing native vmalert series. Empty is expected when the fresh firing count above is zero. This table uses an instant table result so alert labels remain columns."
  },
