 "panels": [
  {
   "id": 1000,
   "title": "PIPELINE / Evidence delivery",
   "type": "text",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 4
   },
   "options": {
    "mode": "markdown",
    "content": "[Work overview](/d/ghostship-autonomous-work) \u00b7 [Host](/d/ghostship-host) \u00b7 [Security](/d/ghostship-security) \u00b7 [Pipeline](/d/ghostship-siem-pipeline) \u00b7 [AI usage](/d/ghostship-ai-usage)\n\nNow and the last six hours. Store ingestion, audit loss, alert delivery and collector freshness. Unknown values mean missing/stale evidence; they are not converted to healthy zeros."
   }
  },
  {
   "id": 8,
   "title": "Firing alerts",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "(count(ALERTS{alertstate=\"firing\"}) or vector(0)) and on() (time() - ghostship_siem_watchdog_last_run_timestamp_seconds < 180) and on() (time() - timestamp(node_uname_info) < 180) and on() (count(node_systemd_unit_state{name=~\"podman-vmalert-(logs|metrics)\\\\.service\",state=\"active\"} == 1) == 2)",
     "legendFormat": "firing",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "Unknown"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   },
   "description": "Zero is shown only while watchdog and node samples are fresh and both vmalert systemd units are active. Unknown otherwise; unit state is not proof that every rule is correct."
  },
