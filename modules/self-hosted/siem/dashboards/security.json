     "maxLines": 200
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 24,
   "title": "sudo and root SSH sessions",
   "type": "logs",
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "gridPos": {
    "w": 24,
    "h": 10,
    "x": 0,
    "y": 34
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "(ident:=sudo OR \"Accepted publickey for root\") | fields _time, ident, _msg",
     "queryType": "instant",
     "maxLines": 200
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ]
