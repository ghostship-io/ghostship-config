  {
   "id": 1000,
   "title": "",
   "type": "text",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "**Security \u00b7 selected range for rates \u00b7 log tables stay collapsed**\n\nStatus colour is reserved for the tiles (good / warning / critical) and always has a number. A missing log stream is Unavailable, never a zero."
   }
  },
  {
   "id": 1001,
   "title": "Log ingestion lag",
   "description": "Counts and rows follow the selected time range. Follows the time picker for log stats.",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "ghostship_log_ingestion_lag_seconds and on() (time() - ghostship_siem_watchdog_last_run_timestamp_seconds < 180)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "Unavailable",
     "color": {
      "mode": "fixed",
      "fixedColor": "#B8BFCC"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#fab219",
        "value": 1
       },
       {
        "color": "#d03b3b",
        "value": 20
       }
      ]
     },
     "mappings": [
      {
       "type": "range",
       "options": {
        "from": 0,
        "to": 1,
        "result": {
         "color": "#0ca30c"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 1,
        "to": 20,
        "result": {
         "color": "#fab219"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 20,
        "to": 1000000000.0,
        "result": {
         "color": "#d03b3b"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "justifyMode": "center",
    "wideLayout": true
   }
  },
