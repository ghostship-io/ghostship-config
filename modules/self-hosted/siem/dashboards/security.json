  {
   "id": 23,
   "title": "Falco events",
   "type": "logs",
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "gridPos": {
    "w": 24,
    "h": 10,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "falco_rule:* | fields _time, falco_rule, falco_priority, falco.container.name, falco.proc.cmdline",
