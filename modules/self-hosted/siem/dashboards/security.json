  {
   "id": 1000,
   "title": "SECURITY / Signals & source health",
   "type": "text",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 4
   },
   "options": {
    "mode": "markdown",
    "content": "[Work overview](/d/ghostship-autonomous-work) \u00b7 [Host](/d/ghostship-host) \u00b7 [Security](/d/ghostship-security) \u00b7 [Pipeline](/d/ghostship-siem-pipeline) \u00b7 [AI usage](/d/ghostship-ai-usage)\n\nToday in UTC. Zero event counts mean no matches in the selected window; an empty series is not proof of healthy collection. Check ingestion and watchdog freshness first. AppArmor ALLOWED is complain-mode learning, not enforcement."
   }
  },
  {
   "id": 1001,
   "title": "Log ingestion lag",
   "description": "",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "ghostship_log_ingestion_lag_seconds and on() (time() - ghostship_siem_watchdog_last_run_timestamp_seconds < 180)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "noValue": "Unknown",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 90
       },
       {
        "color": "red",
        "value": 180
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
