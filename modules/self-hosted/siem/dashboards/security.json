   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 19,
   "title": "SSH authentication failures",
   "type": "timeseries",
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "unit:~\"sshd\" (\"Failed password\" OR \"Invalid user\" OR \"authentication failure\") | stats count() n",
     "queryType": "statsRange"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 20,
   "title": "Firewall refused connections",
