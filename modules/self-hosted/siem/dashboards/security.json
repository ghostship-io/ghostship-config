   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "falco_rule:* | sort by (_time desc) limit 200 | fields _time, _msg, falco_rule, falco_priority, falco.container.name",
     "queryType": "instant",
     "maxLines": 200
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "Unknown"
    },
    "overrides": []
   },
   "options": {
    "showTime": true,
    "showLabels": false,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none"
   },
   "description": "Latest 200 redacted Falco observations. Preserve the message so log rows have readable text; full raw command fields are not added to this dashboard."
