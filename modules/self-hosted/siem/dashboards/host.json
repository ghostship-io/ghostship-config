 "panels": [
  {
   "id": 1000,
   "title": "",
   "type": "text",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "**Host \u00b7 rolling rates follow the time picker \u00b7 gauges are the latest sample**\n\nCPU is every core. Memory is total, used and available. An unknown reading is Unavailable, never a zero."
   }
  },
  {
   "id": 1001,
   "title": "CPU %  (all cores)",
   "description": "Rolling 5-minute busy average of every core.",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "noValue": "Unavailable",
     "color": {
      "mode": "fixed",
      "fixedColor": "#B8BFCC"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       },
       {
        "color": "#fab219",
        "value": 70
       },
       {
        "color": "#d03b3b",
        "value": 90
       }
      ]
     },
     "mappings": [
      {
       "type": "range",
       "options": {
        "from": 0,
        "to": 70,
        "result": {
         "color": "#0ca30c"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 70,
        "to": 90,
        "result": {
         "color": "#fab219"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 90,
        "to": 1000000000.0,
        "result": {
         "color": "#d03b3b"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "justifyMode": "center",
    "wideLayout": true
   }
  },
