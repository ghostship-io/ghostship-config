  {
   "id": 8,
   "title": "CPU per core  /  5-minute busy average",
   "description": "One row per core in numeric order 0..19, time on the x axis. Every cell is that core's busy percentage as a five-minute average (1 - idle rate over 5m), so a single skipped scrape is interpolated rather than shown as a gap; a core with no samples at all has no row. Colour is a restrained threshold (green under 70%, orange to 90%, red above) and the tooltip carries the exact average.",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sort_by_label_numeric(100 * (1 - avg by (cpu) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))), \"cpu\")",
     "legendFormat": "core {{cpu}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "noValue": "\u2014",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "custom": {
      "fillOpacity": 80,
      "lineWidth": 1,
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "mergeValues": false,
    "showValue": "auto",
    "alignValue": "center",
    "rowHeight": 0.85,
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "single",
     "sort": "none"
    }
   }
  },
