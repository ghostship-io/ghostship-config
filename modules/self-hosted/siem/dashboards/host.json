  {
   "id": 8,
   "title": "CPU per core  /  5-minute busy average",
   "description": "Rolling 5-minute busy average, one bar per core in numeric order. Sequential blue ramp (not status colour). A core with no rate is absent.",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 16,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "sort_by_label_numeric(100 * (1 - avg by (cpu) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))), \"cpu\")",
     "legendFormat": "core {{cpu}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "decimals": 0,
     "noValue": "Unavailable",
     "color": {
      "mode": "continuous-Blues"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#1b4f8a",
        "value": null
       },
       {
        "color": "#3987e5",
        "value": 40
       },
       {
        "color": "#7eb0ee",
        "value": 75
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "valueMode": "text",
    "showUnfilled": true,
    "minVizHeight": 10,
    "maxVizHeight": 14,
    "namePlacement": "left",
    "sizing": "manual",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "text": {
     "titleSize": 11,
     "valueSize": 12
    }
   }
  },
