{
  "_id": "plex-hevc-guarded-v1",
  "name": "Plex HEVC guarded v1",
  "description": "HEVC CRF 20 slow, original audio up to 5.1, English subtitles, full decode, and manual approval",
  "priority": 0,
  "isUiLocked": true,
  "flowPlugins": [
    {
      "name": "Input File",
      "sourceRepo": "Community",
      "pluginName": "inputFile",
      "version": "1.0.0",
      "id": "input",
      "position": { "x": 500, "y": 0 },
      "inputsDB": {}
    },
    {
      "name": "Begin Command",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "id": "begin",
      "position": { "x": 500, "y": 120 },
      "inputsDB": {}
    },
    {
      "name": "Apply Plex Policy",
      "sourceRepo": "Local",
      "pluginName": "plexPolicy",
      "version": "1.0.0",
      "id": "policy",
      "position": { "x": 500, "y": 240 },
      "inputsDB": { "pilotOriginalLanguageTags": "eng,en" }
    },
    {
      "name": "Execute Encode",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandExecute",
      "version": "1.0.0",
      "id": "execute",
      "position": { "x": 300, "y": 380 },
      "inputsDB": {}
    },
    {
      "name": "Check Duration",
      "sourceRepo": "Community",
      "pluginName": "compareFileDurationRatio",
      "version": "1.0.0",
      "id": "duration",
      "position": { "x": 300, "y": 500 },
      "inputsDB": { "greaterThan": "99.9", "lessThan": "100.1" }
    },
    {
      "name": "Validate Streams and Size",
      "sourceRepo": "Local",
      "pluginName": "plexValidate",
      "version": "1.0.0",
      "id": "validate",
      "position": { "x": 300, "y": 620 },
      "inputsDB": {}
    },
    {
      "name": "Full Decode Check",
      "sourceRepo": "Community",
      "pluginName": "runCli",
      "version": "1.0.0",
      "id": "decode",
      "position": { "x": 300, "y": 740 },
      "inputsDB": {
        "useCustomCliPath": false,
        "userCli": "ffmpeg",
        "doesCommandCreateOutputFile": false,
        "outputFileBecomesWorkingFile": false,
        "cliArguments": "-v error -xerror -i \"{{{args.inputFileObj._id}}}\" -map 0:v:0 -f null -"
      }
    },
    {
      "name": "Review Validated Output",
      "sourceRepo": "Community",
      "pluginName": "requireReview",
      "version": "1.0.0",
      "id": "review",
      "position": { "x": 300, "y": 860 },
      "inputsDB": {}
    },
    {
      "name": "Replace Pilot Original",
      "sourceRepo": "Local",
      "pluginName": "plexReplace",
      "version": "1.0.0",
      "id": "replace",
      "position": { "x": 300, "y": 980 },
      "inputsDB": {}
    },
    {
      "name": "Review Policy Exception",
      "sourceRepo": "Community",
      "pluginName": "requireReview",
      "version": "1.0.0",
      "id": "policy-review",
      "position": { "x": 650, "y": 380 },
      "inputsDB": {}
    },
    {
      "name": "Remove Reviewed Exception From Queue",
      "sourceRepo": "Community",
      "pluginName": "removeFromTdarr",
      "version": "1.0.0",
      "id": "review-remove",
      "position": { "x": 650, "y": 500 },
      "inputsDB": {}
    },
    {
      "name": "Already Compliant",
      "sourceRepo": "Community",
      "pluginName": "removeFromTdarr",
      "version": "1.0.0",
      "id": "compliant",
      "position": { "x": 850, "y": 380 },
      "inputsDB": {}
    },
    {
      "name": "Fail Validation",
      "sourceRepo": "Community",
      "pluginName": "failFlow",
      "version": "1.0.0",
      "id": "fail",
      "position": { "x": 50, "y": 700 },
      "inputsDB": {}
    }
  ],
  "flowEdges": [
    { "source": "input", "sourceHandle": "1", "target": "begin", "targetHandle": null, "id": "e01" },
    { "source": "begin", "sourceHandle": "1", "target": "policy", "targetHandle": null, "id": "e02" },
    { "source": "policy", "sourceHandle": "1", "target": "execute", "targetHandle": null, "id": "e03" },
    { "source": "policy", "sourceHandle": "2", "target": "policy-review", "targetHandle": null, "id": "e04" },
    { "source": "policy", "sourceHandle": "3", "target": "compliant", "targetHandle": null, "id": "e05" },
    { "source": "policy-review", "sourceHandle": "1", "target": "review-remove", "targetHandle": null, "id": "e06" },
    { "source": "execute", "sourceHandle": "1", "target": "duration", "targetHandle": null, "id": "e07" },
    { "source": "duration", "sourceHandle": "1", "target": "validate", "targetHandle": null, "id": "e08" },
    { "source": "duration", "sourceHandle": "2", "target": "fail", "targetHandle": null, "id": "e09" },
    { "source": "duration", "sourceHandle": "3", "target": "fail", "targetHandle": null, "id": "e10" },
    { "source": "validate", "sourceHandle": "1", "target": "decode", "targetHandle": null, "id": "e11" },
    { "source": "validate", "sourceHandle": "2", "target": "fail", "targetHandle": null, "id": "e12" },
    { "source": "decode", "sourceHandle": "1", "target": "review", "targetHandle": null, "id": "e13" },
    { "source": "review", "sourceHandle": "1", "target": "replace", "targetHandle": null, "id": "e14" }
  ]
}
