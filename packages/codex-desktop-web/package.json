{
  "name": "ghostship-codex-desktop-web",
  "version": "2.0.0",
  "private": true,
  "description": "Browser transport for the upstream ChatGPT Codex desktop renderer",
  "type": "module",
  "scripts": {
    "build:release": "node scripts/prepare-linux.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/*.browser.mjs",
    "test:live": "node tests/live-acceptance.mjs",
    "test:live-ui": "node tests/live-ui-surface.mjs",
    "test:contract": "node scripts/check-release.mjs",
    "start:prepared": "node scripts/start-prepared.mjs"
  },
  "dependencies": {
    "@electron/asar": "4.2.1",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "playwright-core": "1.62.0"
  },
  "engines": {
    "node": ">=22"
  }
}
