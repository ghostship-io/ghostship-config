# The release-window holder, as one definition shared by the module that
# installs it and the check that runs its generated bytes.
{ pkgs }:
pkgs.writeShellApplication {
  name = "ghostship-t3code-window-holder";
  runtimeInputs = [ pkgs.coreutils pkgs.util-linux ];
  text = builtins.readFile ./window-holder.sh;
}
